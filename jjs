        task.cancel(resoluteThread)
        resoluteThread = nil
    end
    refreshResoluteHotkey()
    refreshResoluteLabel()
end

local function resoluteCycle()
    local target = getNearestByMode(resoluteRange, resoluteMode)
    if not target then return false end

    resoluteTargetName = target.Name

    teleportBehindModel(target, resoluteBackDist, resoluteFace)
    fireResolute(target)

    if not resoluteEnabled then return true end
    if resoluteFireDelay > 0 then
        task.wait(resoluteFireDelay)
    end
    if not resoluteEnabled then return true end

    if resoluteReTeleport then
        teleportBehindModel(target, resoluteBackDist, resoluteFace)
    end
    fireResolute(target)

    return true
end

local function startResolute()
    if not ResoluteEvent then
        WindUI:Notify({ Title = "错误", Content = "未找到 ResoluteSwingService 远程事件", Icon = "x", Duration = 2 })
        return false
    end
    if not getResoluteMoveset() then
        WindUI:Notify({ Title = "错误", Content = "角色没有 Moveset.Resolute Slash", Icon = "x", Duration = 2 })
        return false
    end

    stopResolute()
    resoluteEnabled = true
    resoluteCount = 0
    resoluteTargetName = "无"

    resoluteThread = task.spawn(function()
        while resoluteEnabled do
            if not resoluteCycle() then
                task.wait(0.1)
            end
            task.wait(resoluteLoopDelay)
        end
        resoluteThread = nil
    end)

    refreshResoluteHotkey()
    refreshResoluteLabel()
    return true
end

