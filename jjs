			if not blocking and os.clock() - lastDamage < 0.5 then
				setBlock(true)
				lastThreat = os.clock()
			end
			if blocking and os.clock() - lastThreat > BLOCK_GRACE then
				setBlock(false)
			end
		end
	end
end)

local faceConn = nil
local lastFace = 0

local function stopAutoFace()
	if faceConn then
		faceConn:Disconnect()
		faceConn = nil
	end
end

local function startAutoFace()
	stopAutoFace()
	faceConn = RunService.Heartbeat:Connect(function()
		if not cfg.faceTarget or cfg.faceTarget == false then
			stopAutoFace()
			return
		end
		if os.clock() - lastFace < 0.08 then return end
		lastFace = os.clock()
		local target = nearestTarget(200)
		if target then
			faceTarget(target)
		end
	end)
end

