local function getClapTarget()
	local now = os.clock()
	if clapTarget and clapTarget.Parent and (now - clapTargetAt) < 0.6 then
		local hum = clapTarget:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then
			return clapTarget
		end
	end
	clapTarget = nearestTarget(cfg.todoRange)
	clapTargetAt = now
	return clapTarget
end

local function clapAt(remote, target, left)
	if not remote or not target then return false end
	pcall(function()
		if left then
			remote:FireServer(false, target)
		else
			remote:FireServer(target)
		end
	end)
	return true
end

local function todoClap(left)
	local remote = left and TodoClap or TodoSwap
	if not remote then
		WindUI:Notify({Title = "不可用", Content = "没找到 TodoService", Duration = 2})
		return false
	end
	local target = getClapTarget()
	if not target then
		WindUI:Notify({Title = "拍手失败", Content = "范围内没有目标", Duration = 2})
		return false
	end
	return clapAt(remote, target, left)
end

