local function getNearestByMode(range, mode)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local best, minDist = nil, range

    local function consider(model)
        if not model or model == char then return end
        local hum = model:FindFirstChildOfClass("Humanoid")
        local tr = model:FindFirstChild("HumanoidRootPart")
        if not (hum and hum.Health > 0 and tr) then return end
        local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
        if isPlayer and mode == "仅NPC" then return end
        if (not isPlayer) and mode == "仅玩家" then return end
        local d = (root.Position - tr.Position).Magnitude
        if d < minDist then
            minDist = d
            best = model
        end
    end

    local folder = getCharactersFolder()
    if folder then
        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model") then consider(model) end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            consider(plr.Character)
        end
    end

    return best
end

local function teleportBehindModel(model, dist, doFace)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local tr = model and model:FindFirstChild("HumanoidRootPart")
    if not (root and tr) then return false end

    local newPos = (tr.CFrame * CFrame.new(0, 0, dist)).Position
    if doFace then
        root.CFrame = CFrame.lookAt(newPos, Vector3.new(tr.Position.X, newPos.Y, tr.Position.Z))
    else
        root.CFrame = CFrame.new(newPos)
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    return true
end

