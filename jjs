local function isDivergentRemote(remote)
	if typeof(remote) ~= "Instance" then return false end
	if DivergentActivated and remote == DivergentActivated then return true end
	if remote.Name ~= "Activated" then return false end
	local re = remote.Parent
	local svc = re and re.Parent
	if svc and type(svc.Name) == "string" and svc.Name:find("DivergentFist", 1, true) then
		return true
	end
	return false
end

