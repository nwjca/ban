local function readPing()
    local sources = {
        function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end,
        function()
            return Stats.Network.ServerStatsItem:FindFirstChild("Data Ping").Value
        end,
        function()
            return Stats.Network:FindFirstChild("ServerStatsItem"):FindFirstChild("Data Ping").Value
        end
    }
    for _, fn in ipairs(sources) do
        local ok, val = pcall(fn)
        if ok and tonumber(val) and tonumber(val) >= 0 then
            return math.floor(tonumber(val))
        end
    end
    return nil
end

