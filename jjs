local function parseNames(text)
    local out = {}
    if not text then return out end
    for token in string.gmatch(text, "[^,，;；%s]+") do
        out[#out + 1] = string.lower(token)
    end
    return out
end

local faceWhitelist = {}
local faceBlacklist = {}

local function matchAny(list, names)
    for _, item in ipairs(list) do
        for _, n in ipairs(names) do
            if item == n then return true end
        end
    end
    return false
end

local function nameAllowed(player, char)
    local names = {
        string.lower(player.Name or ""),
        string.lower(player.DisplayName or "")
    }
    if char then
        names[#names + 1] = string.lower(char.Name or "")
    end

    if #faceBlacklist > 0 and matchAny(faceBlacklist, names) then
        return false
    end
    if #faceWhitelist > 0 then
        return matchAny(faceWhitelist, names)
    end
    return true
end

