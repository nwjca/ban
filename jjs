local CandyTab = Window:Tab({ Title = "自动糖果透视", Icon = "app-window", Locked = false })

local candyEnabled = false
local candyThread = nil
local candyInterval = 0.5
local candyShowName = true
local candyShowDistance = true
local candyMarkers = {}

local candyPresets = {
    ["糖果粉"] = Color3.fromRGB(255, 120, 200),
    ["万圣橙"] = Color3.fromRGB(255, 150, 60),
    ["荧光绿"] = Color3.fromRGB(120, 255, 130),
    ["亮蓝"] = Color3.fromRGB(90, 190, 255)
}
local candyColor = candyPresets["糖果粉"]

local function isCandyDoor(inst)
    if not inst or not inst.Name then return false end
    return string.find(string.lower(inst.Name), "halloweendoor", 1, true) ~= nil
end

local function getCandyPart(inst)
    if inst:IsA("BasePart") then
        return inst
    elseif inst:IsA("Model") then
        if inst.PrimaryPart then return inst.PrimaryPart end
        return inst:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function removeCandyMarker(door)
    local rec = candyMarkers[door]
    if rec then
        if rec.hl then pcall(function() rec.hl:Destroy() end) end
        if rec.bb then pcall(function() rec.bb:Destroy() end) end
        candyMarkers[door] = nil
    end
end

local function createCandyMarker(door, part)
    local hl = Instance.new("Highlight")
    hl.Name = "IdkCandyHL"
    hl.FillColor = candyColor
    hl.FillTransparency = 0.4
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0.1
    pcall(function()
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    end)
    hl.Adornee = part
    hl.Parent = part

    local bb = Instance.new("BillboardGui")
    bb.Name = "IdkCandyBB"
    bb.Size = UDim2.fromOffset(240, 44)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.MaxDistance = 1000000
    bb.Adornee = part
    bb.Parent = part

    local label = Instance.new("TextLabel")
    label.Name = "CandyText"
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.Arcade
    label.TextSize = 20
    label.TextColor3 = candyColor
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0.3
    label.Text = door.Name
    label.Parent = bb

    local rec = { hl = hl, bb = bb, label = label, part = part }
    candyMarkers[door] = rec
    return rec
end

local function updateCandyMarker(door, rec)
    if not rec or not rec.label then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local part = rec.part
    if not (root and part and part.Parent) then return end

    local dist = (root.Position - part.Position).Magnitude
    local pieces = {}
    if candyShowName then pieces[#pieces + 1] = door.Name end
    if candyShowDistance then pieces[#pieces + 1] = string.format("[%d m]", math.floor(dist)) end
    if #pieces == 0 then pieces[1] = "糖果门" end
    rec.label.Text = table.concat(pieces, "  ")
end

local function refreshCandyMarkers()
    local count = 0
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if isCandyDoor(inst) then
            local part = getCandyPart(inst)
            if part then
                local rec = candyMarkers[inst]
                if not rec or rec.part ~= part or not rec.hl or not rec.hl.Parent then
                    removeCandyMarker(inst)
                    rec = createCandyMarker(inst, part)
                end
                if rec then
                    updateCandyMarker(inst, rec)
                    count = count + 1
                end
            end
        end
    end

    for door, _ in pairs(candyMarkers) do
        if not door.Parent then
            removeCandyMarker(door)
        end
    end

    return count
end

local function clearCandyMarkers()
    for door, _ in pairs(candyMarkers) do
        removeCandyMarker(door)
    end
    candyMarkers = {}
end

local function applyCandyColor()
    for _, rec in pairs(candyMarkers) do
        if rec.hl then rec.hl.FillColor = candyColor end
        if rec.label then rec.label.TextColor3 = candyColor end
    end
end

local function stopCandy()
    candyEnabled = false
    if candyThread then
        task.cancel(candyThread)
        candyThread = nil
    end
end

local function startCandy()
    stopCandy()
    candyEnabled = true

    candyThread = task.spawn(function()
        while candyEnabled do
            pcall(refreshCandyMarkers)
            task.wait(candyInterval)
        end
        candyThread = nil
    end)

    return true
end

