				scanServices()
			end
			local target = nearestTarget(cfg.todoRange)
			if target then
				clapAt(TodoSwap, target, false)
				task.wait(cfg.clapSpeed)
				for i = 1, cfg.clapLeftTimes do
					if not cfg.autoClap then break end
					clapAt(TodoClap, nearestTarget(cfg.todoRange) or target, true)
					if i < cfg.clapLeftTimes then
						task.wait(cfg.clapLeftGap)
					end
				end
				if cfg.autoClap then
					task.wait(cfg.clapLeftSpeed)
				end
			else
				task.wait(0.2)
			end
		end
	end
end)

