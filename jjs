local DivergentFistEvent
local ok, res = pcall(function()
    return ReplicatedStorage.Knit.Knit.Services.DivergentFistService.RE.Activated
end)
DivergentFistEvent = ok and res or nil

local autoLookAt = true
local scanRange = 10
local teleportDist = 4.3
local cycleDelay = 0.25
local secondDelay = 0.38
local targetMode = "仅NPC"
local LOCK_VALID_TIME = 0.2

local enabled = false
local teleportThread = nil
local skillThread = nil
local savedWalkSpeed = nil
local toggleBtn = nil
local hotkeyGui = nil
local cachedMoveSet = nil
local lastLockTime = 0

local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local function isValidTarget(model)
    if not model then return false end
    if model == LocalPlayer.Character then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
    if isPlayer then
        return targetMode == "仅玩家" or targetMode == "NPC和玩家"
    else
        return targetMode == "仅NPC" or targetMode == "NPC和玩家"
    end
end

local function getNearestTarget(root, range)
    local nearest, minDist = nil, range
    local parts = Workspace:GetPartBoundsInRadius(root.Position, range)
    for _, part in ipairs(parts) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model and isValidTarget(model) then
            local targetRoot = model:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                local dist = (root.Position - targetRoot.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = targetRoot
                end
            end
        end
    end
    return nearest
end

local function snapToTarget()
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local target = getNearestTarget(root, scanRange)
    if not target then return false end

    root.CFrame = target.CFrame * CFrame.new(0, 0, teleportDist)

    if autoLookAt then
        root.CFrame = CFrame.new(root.Position, Vector3.new(target.Position.X, root.Position.Y, target.Position.Z))
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function isLocked()
    return (os.clock() - lastLockTime) <= LOCK_VALID_TIME
end

local function waitForLock()
    while enabled do
        if isLocked() then return true end
        if snapToTarget() then
            lastLockTime = os.clock()
            return true
        end
        task.wait(0.05)
    end
    return false
end

local function fireSkill()
    local char = LocalPlayer.Character
    if not char or not DivergentFistEvent then return false end
    if not cachedMoveSet or cachedMoveSet.Parent ~= char.Moveset then
        cachedMoveSet = char:FindFirstChild("Moveset") and char.Moveset:FindFirstChild("Divergent Fist")
    end
    if not cachedMoveSet then return false end
    DivergentFistEvent:FireServer(cachedMoveSet, nil)
    return true
end

local function updateBtnVisual()
    if not toggleBtn then return end
    if enabled then
        toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 110, 60)
        toggleBtn.Text = "ON"
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        toggleBtn.Text = "OFF"
    end
end

local function stopAll()
    enabled = false
    if teleportThread then
        task.cancel(teleportThread)
        teleportThread = nil
    end
    if skillThread then
        task.cancel(skillThread)
        skillThread = nil
    end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and savedWalkSpeed then
        hum.WalkSpeed = savedWalkSpeed
        savedWalkSpeed = nil
    end
    cachedMoveSet = nil
    lastLockTime = 0
    updateBtnVisual()
end

local function startAll()
    if not DivergentFistEvent then
        WindUI:Notify({Title = "错误", Content = "未找到黑闪远程事件", Icon = "x", Duration = 2})
        return false
    end
    stopAll()
    enabled = true

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        savedWalkSpeed = hum.WalkSpeed
        hum.WalkSpeed = 0
    end

    teleportThread = task.spawn(function()
        while enabled do
            if snapToTarget() then
                lastLockTime = os.clock()
            end
            RunService.RenderStepped:Wait()
        end
        teleportThread = nil
    end)

    skillThread = task.spawn(function()
        while enabled do
            if not waitForLock() then break end
            fireSkill()

            task.wait(secondDelay)
            if not enabled then break end

            if not waitForLock() then break end
            fireSkill()

            task.wait(cycleDelay)
        end
        skillThread = nil
    end)

    updateBtnVisual()
    return true
end

local function toggle()
    if enabled then
        stopAll()
        WindUI:Notify({Title = "已关闭", Content = "循环已停止", Icon = "x", Duration = 1.5})
    else
        if startAll() then
            WindUI:Notify({Title = "已开启", Content = "持续瞬移 + 黑闪", Icon = "check", Duration = 1.5})
        end
    end
end

local function createHotkey()
    if not isMobile or hotkeyGui then return end

    local gui = Instance.new("ScreenGui")
    gui.Name = "IdknameggHotkey"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    hotkeyGui = gui

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(52, 52)
    btn.Position = UDim2.new(0, 16, 0.65, 0)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    btn.BackgroundTransparency = 0.25
    btn.Text = "OFF"
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(0, 150, 255)
    stroke.Parent = btn

    toggleBtn = btn
    updateBtnVisual()

    local dragging, dragStart, startPos, moved = false, nil, nil, false

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = btn.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.Touch
            and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local delta = input.Position - dragStart
        if math.abs(delta.X) > 6 or math.abs(delta.Y) > 6 then moved = true end
        btn.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch
            and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not dragging then return end
        dragging = false
        if not moved then toggle() end
    end)
end

local function setHotkeyVisible(state)
    if not isMobile then return end
    if state then
        createHotkey()
        if hotkeyGui then hotkeyGui.Enabled = true end
    elseif hotkeyGui then
        hotkeyGui.Enabled = false
    end
end

