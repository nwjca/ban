local function selfRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function isLoco(name)
	local n = name:lower()
	for _, k in ipairs(LOCO) do
		if n:find(k, 1, true) then return true end
	end
	return false
end

local function nearestTarget(maxDist)
	local char = player.Character
	local hrp = selfRoot()
	if not hrp then return nil end
	local container = workspace:FindFirstChild("Characters") or workspace
	local best, bestDist = nil, maxDist or math.huge
	for _, v in ipairs(container:GetChildren()) do
		if v:IsA("Model") and v ~= char then
			local hum = v:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local root = v.PrimaryPart or v:FindFirstChild("HumanoidRootPart")
				if root then
					local d = (root.Position - hrp.Position).Magnitude
					if d < bestDist then
						best, bestDist = v, d
					end
				end
			end
		end
	end
	return best
end

local function faceTarget(target)
	local hrp = selfRoot()
	local troot = target and (target.PrimaryPart or target:FindFirstChild("HumanoidRootPart"))
	if not hrp or not troot then return false end
	local lookAt = troot.Position - hrp.Position
	lookAt = Vector3.new(lookAt.X, 0, lookAt.Z)
	if lookAt.Magnitude <= 0.1 then return false end
	hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + lookAt)
	return true
end

local function teleportBehind(target)
	local char = player.Character
	local hrp = selfRoot()
	local troot = target and (target.PrimaryPart or target:FindFirstChild("HumanoidRootPart"))
	if not char or not hrp or not troot then return false end
	local pos = troot.Position - troot.CFrame.LookVector * BF_BACK
	local dest = Vector3.new(pos.X, troot.Position.Y, pos.Z)
	char:PivotTo(CFrame.new(dest) * hrp.CFrame.Rotation)
	return true
end

local function teleportOnce()
	local target = nearestTarget(cfg.bfRange)
	if not target then return false end
	teleportBehind(target)
	faceTarget(target)
	return true
end

local function fireChainEffect(target)
	if not cfg.chainEffect then return end
	if not EffectsRemote then return end
	local char = player.Character
	if not char or not target then return end
	pcall(function()
		if firesignal then
			firesignal(EffectsRemote.OnClientEvent, "BlackFlashChain", char, target)
		else
			for _, conn in ipairs(getconnections(EffectsRemote.OnClientEvent)) do
				conn:Fire("BlackFlashChain", char, target)
			end
		end
	end)
end

local function setBlock(state)
	if blocking == state then return end
	if state then
		if not BlockActivated then return end
		BlockActivated:FireServer(nil)
		blocking = true
	else
		if not BlockDeactivated then return end
		BlockDeactivated:FireServer()
		blocking = false
	end
end

local animHook = {}
local animCache = {}
local modelWatch = {}

local pickRemote

local function isAttackAnim(anim)
	if not anim then return false end
	local key = anim.AnimationId .. "|" .. anim.Name
	local cached = animCache[key]
	if cached == nil then
		cached = (anim.AnimationId ~= "" and not isLoco(anim.Name))
		animCache[key] = cached
	end
	return cached
end

local function distToModel(model)
	local hrp = selfRoot()
	local root = model and (model.PrimaryPart or model:FindFirstChild("HumanoidRootPart"))
	if not hrp or not root then return math.huge end
	return (root.Position - hrp.Position).Magnitude
end

local function onAttackHeard(model)
	if not cfg.autoBlock then return end
	if distToModel(model) > cfg.blockRange then return end
	lastThreat = os.clock()
	setBlock(true)
end

local function bindAnimator(model, animator)
	if animHook[model] then return true end
	animHook[model] = {
		conn = animator.AnimationPlayed:Connect(function(track)
			if isAttackAnim(track.Animation) then
				onAttackHeard(model)
			end
		end)
	}
	return true
end

local function hookAnimator(model)
	if animHook[model] then return true end
	local animator = model:FindFirstChild("Animator", true)
	if not animator then return false end
	return bindAnimator(model, animator)
end

local function stopWatch(model)
	if modelWatch[model] then
		modelWatch[model]:Disconnect()
		modelWatch[model] = nil
	end
end

local function watchModel(model)
	if model == player.Character then return end
	if hookAnimator(model) then return end
	if modelWatch[model] then return end
	modelWatch[model] = model.DescendantAdded:Connect(function(d)
		if d:IsA("Animator") and not animHook[model] then
			if bindAnimator(model, d) then
				stopWatch(model)
			end
		end
	end)
end

local function scanAnimators()
	local char = player.Character
	local container = workspace:FindFirstChild("Characters") or workspace
	for _, v in ipairs(container:GetChildren()) do
		if v:IsA("Model") and v ~= char then
			watchModel(v)
		end
	end
	for model, data in pairs(animHook) do
		if not model.Parent or model == char then
			if data.conn then data.conn:Disconnect() end
			animHook[model] = nil
			stopWatch(model)
		end
	end
	for model in pairs(modelWatch) do
		if not model.Parent or model == char then
			stopWatch(model)
		end
	end
end

