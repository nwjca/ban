ComboTab:Button({
    Title = "列出范围内角色",
    Callback = function()
        local folder = getCharactersFolder()
        if not folder then
            WindUI:Notify({ Title = "提示", Content = "未找到 workspace.Characters", Icon = "x", Duration = 2 })
            return
        end

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local list = {}

        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model") and model ~= char then
                local hum = model:FindFirstChildOfClass("Humanoid")
                local tr = model:FindFirstChild("HumanoidRootPart")
                if hum and tr and hum.Health > 0 then
                    local d = root and (root.Position - tr.Position).Magnitude or 0
                    if d <= comboRange then
                        table.insert(list, string.format("%s  血量=%d  距离=%.1f", model.Name, math.floor(hum.Health), d))
                    end
                end
            end
        end

        if #list == 0 then
            WindUI:Notify({ Title = "范围内角色", Content = "没有符合条件的角色", Duration = 3 })
        else
            print(table.concat(list, "\n"))
            WindUI:Notify({ Title = "范围内角色", Content = string.format("共 %d 个，已输出控制台", #list), Duration = 3 })
        end
    end
})

