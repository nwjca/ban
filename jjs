local function updateLayout()
    if not hudBox then return end

    hudGui.Enabled = showHUD

    local w = 178
    local rowH = 28
    local padLeft = 14

    local rows = 0
    if showPingText then rows = rows + 1 end
    if showFPSText then rows = rows + 1 end

    local h = 34
    if rows == 2 then h = 62 end

    hudBox.Size = UDim2.fromOffset(w, h)

    local y1 = 4
    local y2 = 4 + rowH

    hudPingLabel.Visible = showPingText
    hudFpsLabel.Visible = showFPSText

    if showPingText and showFPSText then
        hudPingLabel.Position = UDim2.new(0, padLeft, 0, y1)
        hudFpsLabel.Position = UDim2.new(0, padLeft, 0, y2)
    elseif showPingText then
        hudPingLabel.Position = UDim2.new(0, padLeft, 0, 3)
    elseif showFPSText then
        hudFpsLabel.Position = UDim2.new(0, padLeft, 0, 3)
    end

    hudPingLabel.Size = UDim2.new(1, -padLeft - 8, 0, rowH)
    hudFpsLabel.Size = UDim2.new(1, -padLeft - 8, 0, rowH)

    if hudPingShadow then
        hudPingShadow.Position = UDim2.new(0, padLeft + 2, 0, hudPingLabel.Position.Y.Offset + 2)
        hudPingShadow.Size = hudPingLabel.Size
        hudPingShadow.Visible = showPingText
    end

    if hudFpsShadow then
        hudFpsShadow.Position = UDim2.new(0, padLeft + 2, 0, hudFpsLabel.Position.Y.Offset + 2)
        hudFpsShadow.Size = hudFpsLabel.Size
        hudFpsShadow.Visible = showFPSText
    end

    if hudBadge then
        hudBadge.Visible = (hudStyle == "GTA5")
    end
end

local function applyHudStyle()
    if not hudBox then return end

    local st = getStyle()

    hudBox.BackgroundColor3 = st.bg
    hudBox.BackgroundTransparency = st.bgTransparency
    hudBox.Position = UDim2.new(1, hudOffsetX, 0, hudOffsetY)
    hudBox.Rotation = 0

    local grad = hudBox:FindFirstChildOfClass("UIGradient")
    if grad then
        grad.Color = ColorSequence.new(st.bg, st.bg)
    end

    local corner = hudBox:FindFirstChildOfClass("UICorner")
    if corner then
        corner.CornerRadius = st.corner
    end

    if hudStroke then
        hudStroke.Color = st.strokeColor
        hudStroke.Transparency = st.strokeTransparency
        hudStroke.Thickness = st.thickness
    end

    for _, label in ipairs({ hudPingLabel, hudFpsLabel }) do
        if label then
            label.Font = st.font
            label.TextSize = hudTextSize
            label.TextStrokeColor3 = st.textStrokeColor
            label.TextStrokeTransparency = st.textStrokeTransparency
            label.RichText = true
        end
    end

    for _, label in ipairs({ hudPingShadow, hudFpsShadow }) do
        if label then
            label.Font = st.font
            label.TextSize = hudTextSize
            label.TextColor3 = st.shadowColor
            label.TextTransparency = st.shadowTransparency
            label.TextStrokeTransparency = 1
            label.RichText = false
        end
    end

    if hudPingLabel then hudPingLabel.TextColor3 = st.pingColor end
    if hudFpsLabel then hudFpsLabel.TextColor3 = st.fpsColor end

    updateLayout()
end

local function pingDisplayColor()
    local base = toHex(getStyle().pingColor)
    if not pingValue then return base end
    if not hudColorByPing then return base end
    if pingValue <= 80 then
        return base
    elseif pingValue <= 150 then
        return "#FFE96B"
    else
        return "#FF4D6D"
    end
end

local function refreshHudText()
    local st = getStyle()
    local tagColor = st.tagColor
    local valText = pingValue and (tostring(pingValue) .. " ms") or "--"

    if hudPingLabel then
        hudPingLabel.Text = string.format('<font color="%s">PING</font>  <font color="%s">%s</font>', tagColor, pingDisplayColor(), valText)
    end

    if hudPingShadow then
        hudPingShadow.Text = string.format("PING  %s", valText)
    end

    if hudFpsLabel then
        hudFpsLabel.Text = string.format('<font color="%s">FPS</font>  <font color="%s">%d</font>', tagColor, toHex(st.fpsColor), math.floor(fpsValue))
    end

    if hudFpsShadow then
        hudFpsShadow.Text = string.format("FPS  %d", math.floor(fpsValue))
    end
end

