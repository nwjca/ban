local teleIndex = 0
local teleNextAt = 0
local lastTeleAtk = 0

local function teleAttackTarget(t)
	if os.clock() - lastTeleAtk < cfg.teleAtkGap then return end
	lastTeleAtk = os.clock()
	local remote = pickRemote()
	if not remote or not t then return end
	for _, name in ipairs(cfg.finishers) do
		local action = FINISH_MAP[name]
		if action then
			pcall(function()
				remote:FireServer(action, t)
			end)
			task.wait(FINISH_GAP)
		end
	end
end

RunService.Heartbeat:Connect(function()
	if not cfg.teleAll then return end
	local now = os.clock()
	if now < teleNextAt then return end
	teleNextAt = now + cfg.teleGap
	if cfg.teleNoClip then
		pcall(setNoClip, true)
	end
	local list = allTargets(cfg.teleRange)
	local n = #list
	if n == 0 then return end
	local cap = math.min(n, cfg.teleCount)
	if teleIndex >= cap then teleIndex = 0 end
	teleIndex = teleIndex + 1
	local t = list[teleIndex]
	if t then
		teleportToTarget(t, cfg.teleMode)
		faceTarget(t)
		if cfg.teleAttack then
			task.spawn(teleAttackTarget, t)
		end
	end
end)

