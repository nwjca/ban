local function getResoluteMoveset()
    local char = LocalPlayer.Character
    if not char then return nil end
    local movesetFolder = char:FindFirstChild("Moveset")
    if not movesetFolder then return nil end
    return movesetFolder:FindFirstChild("Resolute Slash")
end

local function fireResolute(model)
    if not ResoluteEvent or not model then return false end
    local moveset = getResoluteMoveset()
    if not moveset then return false end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local tr = model:FindFirstChild("HumanoidRootPart")
    if not (root and tr) then return false end

    local pos
    if resolutePosMode == "目标位置" then
        pos = tr.Position
    else
        pos = root.Position
    end

    local okFire = pcall(function()
        ResoluteEvent:FireServer(moveset, {
            false,
            model,
            pos,
            Vector3.new(0, 0, 0)
        })
    end)

    if okFire then
        resoluteCount = resoluteCount + 1
    end
    return okFire
end

