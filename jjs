	if not hum then return end
	if cfg.lockJump then
		if hum.UseJumpPower ~= true then
			pcall(function() hum.UseJumpPower = true end)
		end
		if hum.JumpPower ~= cfg.jumpPower then
			pcall(function() hum.JumpPower = cfg.jumpPower end)
		end
