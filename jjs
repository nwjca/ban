local candyEnabled = false
local candyThread = nil
local candyInterval = 0.5
local candyColor = Color3.fromRGB(255, 120, 200)
local candyShowName = true
local candyShowDist = true
local candyFillTransparency = 0.55

local CANDY_PRESETS = {
	["糖果粉"] = Color3.fromRGB(255, 120, 200),
	["薄荷绿"] = Color3.fromRGB(110, 230, 170),
	["冰蓝"] = Color3.fromRGB(120, 200, 255),
	["柠檬黄"] = Color3.fromRGB(255, 224, 120),
}

local function isCandyName(name)
	return string.find(string.lower(name), "halloweendoor") ~= nil
end

local function candyDistance(part)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return 0 end
	return math.floor((root.Position - part.Position).Magnitude)
end

local function clearCandy()
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst.Name == "IdkCandyHL" or inst.Name == "IdkCandyBB" then
			pcall(function() inst:Destroy() end)
		end
	end
end

local function applyCandy(inst)
	if not inst:IsA("BasePart") then return end

	local hl = inst:FindFirstChild("IdkCandyHL")
	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = "IdkCandyHL"
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Adornee = inst
		hl.Parent = inst
	end
	hl.FillColor = candyColor
	hl.FillTransparency = candyFillTransparency
	hl.OutlineColor = candyColor
	hl.OutlineTransparency = 0

	local bb = inst:FindFirstChild("IdkCandyBB")
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "IdkCandyBB"
		bb.Size = UDim2.fromOffset(240, 44)
		bb.StudsOffset = Vector3.new(0, 3, 0)
		bb.AlwaysOnTop = true
		bb.Adornee = inst
		bb.Parent = inst

		local label = Instance.new("TextLabel")
		label.Name = "CandyText"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.Arcade
		label.TextSize = 20
		label.TextColor3 = candyColor
		label.TextStrokeTransparency = 0
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		label.Parent = bb
	end

	local label = bb:FindFirstChild("CandyText")
	if label then
		label.TextColor3 = candyColor
		local parts = {}
		if candyShowName then
			parts[#parts + 1] = "糖果门"
		end
		if candyShowDist then
			parts[#parts + 1] = "[ " .. tostring(candyDistance(inst)) .. " 格 ]"
		end
		label.Text = table.concat(parts, "  ")
	end
end

local function scanCandy()
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("BasePart") and isCandyName(inst.Name) then
			applyCandy(inst)
		end
	end
end

local function refreshCandyStyle()
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst.Name == "IdkCandyHL" and inst:IsA("Highlight") then
			inst.FillColor = candyColor
			inst.FillTransparency = candyFillTransparency
			inst.OutlineColor = candyColor
		elseif inst.Name == "IdkCandyBB" and inst:IsA("BillboardGui") then
			local label = inst:FindFirstChild("CandyText")
			if label then
				label.TextColor3 = candyColor
			end
		end
	end
end

local function stopCandy()
	candyEnabled = false
	if candyThread then
		task.cancel(candyThread)
		candyThread = nil
	end
end

local function startCandy()
	stopCandy()
	candyEnabled = true
	candyThread = task.spawn(function()
		while candyEnabled do
			pcall(scanCandy)
			task.wait(candyInterval)
		end
		candyThread = nil
	end)
end

