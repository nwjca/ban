local function finishTarget()
	if cfg.finishAutoTarget and lastTarget and lastTarget.Parent then
		return lastTarget
	end
	return nearestTarget(cfg.finishRange)
end

local function fireFinishers()
	if os.clock() - lastFire < COOLDOWN then return end
	local remote = pickRemote()
	if not remote then return end
	local arg = finishTarget()
	if not arg then return end
	lastFire = os.clock()
	firing = true
	for _, name in ipairs(cfg.finishers) do
		local action = FINISH_MAP[name]
		if action then
			remote:FireServer(action, arg)
			task.wait(FINISH_GAP)
		end
	end
	firing = false
end

local function fireSkill(remote, args)
	pcall(function()
		remote:FireServer(table.unpack(args, 1, args.n))
	end)
end

local function blackFlashSequence(remote, args)
	local target = nearestTarget(cfg.bfRange)
	for i = 1, cfg.bfHits do
		teleportOnce()
		task.wait(BF_SETTLE)
		local who = nearestTarget(cfg.bfRange) or target
		if who then faceTarget(who) end
		fireSkill(remote, args)
		if i < cfg.bfHits then
			task.wait(BF_INTERVAL)
		end
	end

	local who = nearestTarget(cfg.bfRange) or target
	if who then faceTarget(who) end
	pcall(fireChainEffect, who)
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
	local method = getnamecallmethod()
	local args = table.pack(...)

	if method ~= "FireServer" then
		return oldNamecall(self, table.unpack(args, 1, args.n))
	end

	local isDiv = false
	pcall(function()
		isDiv = isDivergentRemote(self)
	end)

	if isDiv then
		if cfg.blackFlash then
			if bfBusy then
				return oldNamecall(self, table.unpack(args, 1, args.n))
			end
			bfBusy = true
			task.spawn(function()
				pcall(blackFlashSequence, self, args)
				bfBusy = false
			end)
			return
		end
		return oldNamecall(self, table.unpack(args, 1, args.n))
	end

	if remotes[self] and cfg.enabled and not firing then
		pcall(function()
			activeRemote = self
			for i = args.n, 1, -1 do
				local v = args[i]
				if typeof(v) == "Instance" and v:IsA("Model") and v ~= player.Character then
					lastTarget = v
					break
				end
			end
			seq = seq + 1
			local my = seq
			task.delay(COMBO_GAP, function()
				if my ~= seq or not cfg.enabled or firing then return end
				task.spawn(fireFinishers)
			end)
		end)
	end

	return oldNamecall(self, table.unpack(args, 1, args.n))
end)

