local function isValidTarget(model)
    if not model then return false end
    if model == LocalPlayer.Character then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
    if isPlayer then
        return targetMode == "仅玩家" or targetMode == "NPC和玩家"
    else
        return targetMode == "仅NPC" or targetMode == "NPC和玩家"
    end
end

local function scanNearestTarget(root, range)
    local nearest, minDist = nil, range
    local parts = Workspace:GetPartBoundsInRadius(root.Position, range)
    for _, part in ipairs(parts) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model and isValidTarget(model) then
            local targetRoot = model:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                local dist = (root.Position - targetRoot.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = targetRoot
                end
            end
        end
    end
    return nearest
end

local function getCachedTarget(root)
    if not useCache then
        return scanNearestTarget(root, scanRange)
    end
    local now = os.clock()
    if cachedTargetRoot and cachedTargetRoot.Parent and (now - cachedTargetTime) < TARGET_CACHE_TIME then
        local model = cachedTargetRoot.Parent
        local hum = model and model:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            return cachedTargetRoot
        end
    end
    cachedTargetRoot = scanNearestTarget(root, scanRange)
    cachedTargetTime = now
    return cachedTargetRoot
end

local function snapToTarget()
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local target = getCachedTarget(root)
    if not target then return false end

    root.CFrame = target.CFrame * CFrame.new(0, 0, teleportDist)

    if autoLookAt then
        root.CFrame = CFrame.new(root.Position, Vector3.new(target.Position.X, root.Position.Y, target.Position.Z))
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function isLocked()
    return (os.clock() - lastLockTime) <= LOCK_VALID_TIME
end

local function waitForLock()
    while enabled do
        if isLocked() then return true end
        if snapToTarget() then
            lastLockTime = os.clock()
            return true
        end
        task.wait(0.05)
    end
    return false
end

local function fireSkill()
    local remote = getRemote("DivergentFistService", "Activated")
    if not remote then return false end
    local moveset = getMovesetChild("Divergent Fist")
    if not moveset then return false end
    if not canSend("divergent", BLACK_MIN_INTERVAL) then return false end
    local ok = pcall(function()
        remote:FireServer(moveset, nil)
    end)
    return ok
end

local function refreshBlackHotkey()
    if hotkeyBlack then hotkeyBlack.refresh() end
end

local function stopAll()
    enabled = false
    if teleportThread then
        task.cancel(teleportThread)
        teleportThread = nil
    end
    if skillThread then
        task.cancel(skillThread)
        skillThread = nil
    end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and savedWalkSpeed then
        hum.WalkSpeed = savedWalkSpeed
        savedWalkSpeed = nil
    end
    lastLockTime = 0
    cachedTargetRoot = nil
    refreshBlackHotkey()
end

local function startAll()
    if not getRemote("DivergentFistService", "Activated") then
        WindUI:Notify({Title = "错误", Content = "未找到黑闪远程事件", Icon = "x", Duration = 2})
        return false
    end
    stopAll()
    enabled = true

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        savedWalkSpeed = hum.WalkSpeed
        hum.WalkSpeed = 0
    end

    teleportThread = task.spawn(function()
        while enabled do
            if snapToTarget() then
                lastLockTime = os.clock()
            end
            RunService.RenderStepped:Wait()
        end
        teleportThread = nil
    end)

    skillThread = task.spawn(function()
        while enabled do
            if not waitForLock() then break end
            fireSkill()

            task.wait(secondDelay)
            if not enabled then break end

            if not waitForLock() then break end
            fireSkill()

            task.wait(cycleDelay)
        end
        skillThread = nil
    end)

    refreshBlackHotkey()
    return true
end

local function toggle()
    if enabled then
        stopAll()
        WindUI:Notify({Title = "已关闭", Content = "循环已停止", Icon = "x", Duration = 1.5})
    else
        if startAll() then
            WindUI:Notify({Title = "已开启", Content = "持续瞬移 + 黑闪", Icon = "check", Duration = 1.5})
        end
    end
    refreshBlackHotkey()
end

