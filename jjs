local function isAttackAnim(anim)
	if not anim then return false end
	local key = anim.AnimationId .. "|" .. anim.Name
	local cached = animCache[key]
	if cached == nil then
		cached = (anim.AnimationId ~= "" and not isLoco(anim.Name))
		animCache[key] = cached
	end
	return cached
end

local function distToModel(model)
	local hrp = selfRoot()
	local root = model and (model.PrimaryPart or model:FindFirstChild("HumanoidRootPart"))
	if not hrp or not root then return math.huge end
	return (root.Position - hrp.Position).Magnitude
end

local function onAttackHeard(model)
	if not cfg.autoBlock then return end
	if distToModel(model) > cfg.blockRange then return end
	lastThreat = os.clock()
	setBlock(true)
end

local function bindAnimator(model, animator)
	if animHook[model] then return true end
	animHook[model] = {
		conn = animator.AnimationPlayed:Connect(function(track)
			if isAttackAnim(track.Animation) then
				onAttackHeard(model)
			end
		end)
	}
	return true
end

local function hookAnimator(model)
	if animHook[model] then return true end
	local animator = model:FindFirstChild("Animator", true)
	if not animator then return false end
	return bindAnimator(model, animator)
end

local function stopWatch(model)
	if modelWatch[model] then
		modelWatch[model]:Disconnect()
		modelWatch[model] = nil
	end
end

local function watchModel(model)
	if model == player.Character then return end
	if hookAnimator(model) then return end
	if modelWatch[model] then return end
	modelWatch[model] = model.DescendantAdded:Connect(function(d)
		if d:IsA("Animator") and not animHook[model] then
			if bindAnimator(model, d) then
				stopWatch(model)
			end
		end
	end)
end

local function scanAnimators()
	local char = player.Character
	local container = workspace:FindFirstChild("Characters") or workspace
	for _, v in ipairs(container:GetChildren()) do
		if v:IsA("Model") and v ~= char then
			watchModel(v)
		end
	end
	for model, data in pairs(animHook) do
		if not model.Parent or model == char then
			if data.conn then data.conn:Disconnect() end
			animHook[model] = nil
			stopWatch(model)
		end
	end
	for model in pairs(modelWatch) do
		if not model.Parent or model == char then
			stopWatch(model)
		end
	end
end

