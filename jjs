    RunService.RenderStepped:Connect(function(dt)
        frames = frames + 1
        acc = acc + dt
        if acc >= 0.5 then
            fpsValue = math.max(0, math.floor(frames / acc + 0.5))
            frames = 0
            acc = 0
        end
