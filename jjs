end

local function nearestTarget(maxDist)
	local char = player.Character
	local hrp = selfRoot()
	if not hrp then return nil end
	local container = workspace:FindFirstChild("Characters") or workspace
	local best, bestDist = nil, maxDist or math.huge
	for _, v in ipairs(container:GetChildren()) do
		if v:IsA("Model") and v ~= char then
			local hum = v:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local root = v.PrimaryPart or v:FindFirstChild("HumanoidRootPart")
				if root then
					local d = (root.Position - hrp.Position).Magnitude
					if d < bestDist then
						best, bestDist = v, d
					end
				end
			end
		end
	end
	return best
end

local function allTargets(maxDist)
	local char = player.Character
	local hrp = selfRoot()
	if not hrp then return {} end
	local container = workspace:FindFirstChild("Characters") or workspace
	local out = {}
	for _, v in ipairs(container:GetChildren()) do
		if v:IsA("Model") and v ~= char then
			local hum = v:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local root = v.PrimaryPart or v:FindFirstChild("HumanoidRootPart")
				if root then
					local d = (root.Position - hrp.Position).Magnitude
					if maxDist <= 0 or d <= maxDist then
						out[#out + 1] = { model = v, dist = d }
					end
				end
			end
		end
	end
	table.sort(out, function(a, b) return a.dist < b.dist end)
	local models = {}
	for _, item in ipairs(out) do
		models[#models + 1] = item.model
	end
	return models
end

local function faceTarget(target)
	local hrp = selfRoot()
	local troot = target and (target.PrimaryPart or target:FindFirstChild("HumanoidRootPart"))
	if not hrp or not troot then return false end
	local lookAt = troot.Position - hrp.Position
	lookAt = Vector3.new(lookAt.X, 0, lookAt.Z)
	if lookAt.Magnitude <= 0.1 then return false end
	hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + lookAt)
	return true
end

local function teleportBehind(target, back)
	local char = player.Character
	local hrp = selfRoot()
	local troot = target and (target.PrimaryPart or target:FindFirstChild("HumanoidRootPart"))
	if not char or not hrp or not troot then return false end
	local dist = back or cfg.bfBack
	local pos = troot.Position - troot.CFrame.LookVector * dist
	local dest = Vector3.new(pos.X, troot.Position.Y, pos.Z)
	char:PivotTo(CFrame.new(dest) * hrp.CFrame.Rotation)
	return true
end

local function teleportOnce()
	local target = nearestTarget(cfg.bfRange)
	if not target then return false end
	teleportBehind(target)
	faceTarget(target)
	return true
end

local function tweenTo(part, targetCF, duration)
	if not part or not targetCF then return end
	if tpTween then
		pcall(function()
			tpTween:Cancel()
		end)
		tpTween = nil
	end
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local okTween, tween = pcall(function()
		return TweenService:Create(part, info, { CFrame = targetCF })
	end)
	if not okTween or not tween then return end
	tpTween = tween
	tween:Play()
	return tween
end

local function stopVoid()
	voidRunning = false
	voidForward = false
	if tpTween then
		pcall(function()
			tpTween:Cancel()
		end)
		tpTween = nil
	end
end

local function startVoid()
	stopVoid()
	local hrp = selfRoot()
	if not hrp then return end
	voidRunning = true
	local dest = hrp.Position + Vector3.new(0, cfg.voidRise, 0)
	local tween = tweenTo(hrp, CFrame.new(dest) * hrp.CFrame.Rotation, cfg.voidRiseTime)
	if not tween then
		voidForward = true
		return
	end
	task.delay(math.max(cfg.voidRiseTime, 0.05) + 0.02, function()
		if voidRunning and cfg.voidOn then
			voidForward = true
		end
	end)
end

local function teleportToTarget(target, mode)
	local char = player.Character
	local hrp = selfRoot()
	if not char or not hrp or not target or not target.Parent then return false end
	local troot = target.PrimaryPart or target:FindFirstChild("HumanoidRootPart")
	if not troot then return false end
	local dest
	if mode == "above" then
		dest = troot.Position + Vector3.new(0, cfg.teleHeight, 0)
	elseif mode == "front" then
		local p = troot.Position + troot.CFrame.LookVector * cfg.teleBack
		dest = Vector3.new(p.X, troot.Position.Y, p.Z)
	else
		local p = troot.Position - troot.CFrame.LookVector * cfg.teleBack
		dest = Vector3.new(p.X, troot.Position.Y, p.Z)
	end
	local cur = hrp.Position
	local delta = dest - cur
	if cfg.teleStep > 0 and delta.Magnitude > cfg.teleStep then
		dest = cur + delta.Unit * cfg.teleStep
	end
	if cfg.teleMethod == "tween" then
		tweenTo(hrp, CFrame.new(dest) * hrp.CFrame.Rotation, cfg.teleTweenTime)
		return true
	end
	local okMove = pcall(function()
		char:PivotTo(CFrame.new(dest))
	end)
	return okMove
end

local function fireChainEffect(target)
	if not cfg.chainEffect then return end
	if not EffectsRemote then return end
	local char = player.Character
	if not char or not target then return end
	pcall(function()
		if firesignal then
			firesignal(EffectsRemote.OnClientEvent, "BlackFlashChain", char, target)
		else
			for _, conn in ipairs(getconnections(EffectsRemote.OnClientEvent)) do
				conn:Fire("BlackFlashChain", char, target)
			end
		end
	end)
end

local function setBlock(state)
	if blocking == state then return end
	if state then
		if not BlockActivated then return end
		BlockActivated:FireServer(nil)
		blocking = true
	else
		if not BlockDeactivated then return end
		BlockDeactivated:FireServer()
		blocking = false
	end
end

