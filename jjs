local espOn = false
local espRange = 0
local espMax = 5
local espDoors = {}
local espAnchors = {}
local espScanAt = 0
local espTickAt = 0
local espPool = {}

local espNames = {
	"halloweendoor",
	"halloween door",
	"candydoor",
	"candy door",
}

local function nameMatchesDoor(name)
	local n = name:lower()
	for _, k in ipairs(espNames) do
		if n:find(k, 1, true) then return true end
	end
	if n:find("halloween", 1, true) and n:find("door", 1, true) then return true end
	return false
end

local function isDoorObject(obj)
	if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
	return nameMatchesDoor(obj.Name)
end

local function doorAnchor(obj)
	local cached = espAnchors[obj]
	if cached and cached.Parent then return cached end
	local part
	if obj:IsA("BasePart") then
		part = obj
	else
		part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
	end
	espAnchors[obj] = part
	return part
end

local function walkDoors(inst, out, depth)
	if depth > 6 or #out >= 40 then return end
	for _, c in ipairs(inst:GetChildren()) do
		if isDoorObject(c) then
			out[#out + 1] = c
		elseif c:IsA("Model") or c:IsA("Folder") then
			walkDoors(c, out, depth + 1)
		end
	end
end

local function rescanDoors()
	local out = {}
	walkDoors(workspace, out, 0)
	espDoors = out
	espScanAt = os.clock()
end

local function makePoolEntry()
	local bill = Instance.new("BillboardGui")
	bill.Name = "DoorESP"
	bill.AlwaysOnTop = true
	bill.LightInfluence = 0
	bill.Size = UDim2.fromOffset(160, 26)
	bill.MaxDistance = 100000
	bill.Adornee = nil
	bill.Enabled = false
	bill.Parent = workspace.CurrentCamera

	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.GothamBold
	text.TextSize = 15
	text.TextColor3 = Color3.fromRGB(255, 105, 180)
	text.TextStrokeTransparency = 1
	text.Text = ""
	text.Parent = bill

	return { bill = bill, text = text }
end

local function ensurePool()
	while #espPool < espMax do
		espPool[#espPool + 1] = makePoolEntry()
	end
end

local function clearPool()
	for _, entry in ipairs(espPool) do
		entry.bill.Enabled = false
		entry.bill.Adornee = nil
		entry.text.Text = ""
	end
end

local function updateEsp()
	local hrp = selfRoot()
	if not hrp then return end
	if os.clock() - espScanAt > 6 then
		pcall(rescanDoors)
	end

	local selfpos = hrp.Position
	local best = {}
	for _, door in ipairs(espDoors) do
		if door.Parent then
			local anchor = doorAnchor(door)
			if anchor and anchor.Parent then
				local dist = (anchor.Position - selfpos).Magnitude
				if espRange <= 0 or dist <= espRange then
					local n = #best
					if n < espMax then
						best[n + 1] = { anchor = anchor, dist = dist }
					elseif dist < best[n].dist then
						best[n] = { anchor = anchor, dist = dist }
					end
					table.sort(best, function(a, b) return a.dist < b.dist end)
				end
			end
		end
	end

	ensurePool()
	for i = 1, espMax do
		local slot = espPool[i]
		local item = best[i]
		if item then
			slot.bill.Adornee = item.anchor
			slot.bill.StudsOffsetWorldSpace = Vector3.new(0, item.anchor.Size.Y / 2 + 1.5, 0)
			slot.bill.Enabled = true
			slot.text.Text = tostring(math.floor(item.dist)) .. "m"
		elseif slot.bill.Enabled then
			slot.bill.Enabled = false
		end
	end
end

