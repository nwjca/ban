local ComboTab = Window:Tab({ Title = "东堂", Icon = "swords", Locked = false })

local comboEnabled = false
local comboThread = nil
local comboRange = 18
local comboCallDelay = 0.35
local comboLoopDelay = 0.3
local comboOrder = "右键→左键"
local COMBO_TARGET_CACHE_TIME = 0.1
local comboCharactersFolder = nil
local comboCacheTarget = nil
local comboCacheTime = 0
local hotkeyCombo = nil

local function getCharactersFolder()
    if useCache and comboCharactersFolder and comboCharactersFolder.Parent then
        return comboCharactersFolder
    end
    comboCharactersFolder = Workspace:FindFirstChild("Characters")
    return comboCharactersFolder
end

local function scanNearestCharacter()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local folder = getCharactersFolder()
    if not folder then return nil end

    local best, minDist = nil, comboRange
    for _, model in ipairs(folder:GetChildren()) do
        if model:IsA("Model") and model ~= char then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local tr = model:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and tr then
                local d = (root.Position - tr.Position).Magnitude
                if d < minDist then
                    minDist = d
                    best = model
                end
            end
        end
    end
    return best
end

local function getNearestCharacter()
    if not useCache then
        return scanNearestCharacter()
    end
    local now = os.clock()
    if comboCacheTarget and comboCacheTarget.Parent and (now - comboCacheTime) < COMBO_TARGET_CACHE_TIME then
        local hum = comboCacheTarget:FindFirstChildOfClass("Humanoid")
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local tr = comboCacheTarget:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and root and tr then
            if (root.Position - tr.Position).Magnitude <= comboRange then
                return comboCacheTarget
            end
        end
    end
    comboCacheTarget = scanNearestCharacter()
    comboCacheTime = now
    return comboCacheTarget
end

local function fireActive(target)
    local remote = getRemote("TodoService", "Activated")
    if not remote or not target then return false end
    if not canSend("todoActive", 0.02) then return false end
    local ok = pcall(function()
        remote:FireServer(false, target)
    end)
    return ok
end

local function fireRight(target)
    local remote = getRemote("TodoService", "RightActivated")
    if not remote or not target then return false end
    if not canSend("todoRight", 0.02) then return false end
    local ok = pcall(function()
        remote:FireServer(target)
    end)
    return ok
end

local function attackOnce()
    local target = getNearestCharacter()
    if not target then return false end

    if comboOrder == "右键→左键" then
        fireRight(target)
        if comboCallDelay > 0 then task.wait(comboCallDelay) end
        fireActive(target)
    elseif comboOrder == "左键→右键" then
        fireActive(target)
        if comboCallDelay > 0 then task.wait(comboCallDelay) end
        fireRight(target)
    else
        fireActive(target)
        if comboCallDelay > 0 then task.wait(comboCallDelay) end
        fireActive(target)
