local comboHotkeyVisible = true
local COMBO_HOTKEY_DEFAULT_POS = UDim2.new(0, 16, 0.78, 0)

local function getCharactersFolder()
    return Workspace:FindFirstChild("Characters")
end

local function getNearestCharacter()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local folder = getCharactersFolder()
    if not folder then return nil end

    local best, minDist = nil, comboRange
    for _, model in ipairs(folder:GetChildren()) do
        if model:IsA("Model") and model ~= char then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local tr = model:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and tr then
                local d = (root.Position - tr.Position).Magnitude
                if d < minDist then
                    minDist = d
                    best = model
                end
            end
        end
    end
    return best
end

local function fireActive(target)
    if not TodoActiveEvent or not target then return false end
    local ok5 = pcall(function()
        TodoActiveEvent:FireServer(false, target)
    end)
    if ok5 then
        comboCount = comboCount + 1
    end
    return ok5
end

local function fireRight(target)
    if not TodoRightEvent or not target then return false end
    local ok6 = pcall(function()
        TodoRightEvent:FireServer(target)
    end)
    if ok6 then
        comboRightCount = comboRightCount + 1
    end
    return ok6
end

local function attackOnce()
    local target = getNearestCharacter()
    if not target then return false end

    comboLastTarget = target.Name

    if comboMode == "仅左键" then
        fireActive(target)
    elseif comboMode == "仅右键" then
        fireRight(target)
    else
        fireActive(target)
        if comboCallDelay > 0 then
            task.wait(comboCallDelay)
        end
        fireRight(target)
    end

    return true
end

local function updateComboBtnVisual()
    if not comboHotkeyBtn then return end
    if comboEnabled then
        comboHotkeyBtn.BackgroundColor3 = Color3.fromRGB(0, 110, 60)
        comboHotkeyBtn.Text = "ON"
        comboHotkeyBtn.TextColor3 = Color3.fromRGB(235, 255, 240)
    else
        comboHotkeyBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        comboHotkeyBtn.Text = "OFF"
        comboHotkeyBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end

local function refreshComboLabel()
    if not comboLabel then return end
    local lines = {}
    table.insert(lines, "运行状态: " .. (comboEnabled and "开启" or "关闭"))
    table.insert(lines, "连招模式: " .. comboMode)
    table.insert(lines, string.format("攻击范围: %.1f", comboRange))
    table.insert(lines, string.format("左键/右键间隔: %.3f 秒", comboCallDelay))
    table.insert(lines, string.format("循环间隔: %.3f 秒", comboLoopDelay))
    table.insert(lines, "最近目标: " .. comboLastTarget)
    table.insert(lines, "左键发送: " .. tostring(comboCount) .. " 次")
    table.insert(lines, "右键发送: " .. tostring(comboRightCount) .. " 次")
    pcall(function()
        comboLabel:SetTitle(table.concat(lines, "\n"))
    end)
end

local function stopCombo()
    comboEnabled = false
    if comboThread then
        task.cancel(comboThread)
        comboThread = nil
    end
    updateComboBtnVisual()
    refreshComboLabel()
end

local function startCombo()
    if not TodoActiveEvent and not TodoRightEvent then
        WindUI:Notify({ Title = "错误", Content = "未找到 TodoService 远程事件", Icon = "x", Duration = 2 })
        return false
    end
    stopCombo()
    comboEnabled = true
    comboCount = 0
    comboRightCount = 0
    comboLastTarget = "无"

    comboThread = task.spawn(function()
        while comboEnabled do
            if not attackOnce() then
                task.wait(0.1)
            end
            task.wait(comboLoopDelay)
        end
        comboThread = nil
    end)

    updateComboBtnVisual()
    refreshComboLabel()
    return true
end

