local function ensureServices()
	if servicesRoot and servicesRoot.Parent then
		return servicesRoot
	end
	local knit = ReplicatedStorage:FindFirstChild("Knit")
	if not knit then return nil end
	local inner = knit:FindFirstChild("Knit")
	local root = inner or knit
	servicesRoot = root:FindFirstChild("Services")
	return servicesRoot
end

local function resolveRemote(serviceName, remoteName)
	local services = ensureServices()
	if not services then return nil end
	local svc = services:FindFirstChild(serviceName)
	if not svc then return nil end
	local re = svc:FindFirstChild("RE")
	if not re then return nil end
	return re:FindFirstChild(remoteName)
end

local function scanServices()
	local services = ensureServices()
	if not services then return end
	for _, name in ipairs(SERVICES) do
		local remote = resolveRemote(name, "Activated")
		if remote then
			remotes[remote] = name
			remoteList[name] = remote
		end
	end
	BlockActivated = BlockActivated or resolveRemote("BlockService", "Activated")
	BlockDeactivated = BlockDeactivated or resolveRemote("BlockService", "Deactivated")
	if not DivergentActivated then
		local svc = services:FindFirstChild("DivergentFistService")
		if svc then
			local re = svc:FindFirstChild("RE")
			DivergentActivated = re and re:FindFirstChild("Activated")
		end
	end
	if not EffectsRemote then
		local svc = services:FindFirstChild("DivergentFistService")
		if svc then
			local re = svc:FindFirstChild("RE")
			EffectsRemote = re and re:FindFirstChild("Effects")
		end
	end
	TodoClap = TodoClap or resolveRemote("TodoService", "Activated")
	TodoSwap = TodoSwap or resolveRemote("TodoService", "RightActivated")
end

