local MoveSetCache = { char = nil, moves = {} }
local SendThrottle = {}

local function getRemote(serviceName, eventName)
    local key = serviceName .. "." .. eventName
    if useCache and RemoteCache[key] then
        return RemoteCache[key]
    end
    local ok, res = pcall(function()
        return ReplicatedStorage.Knit.Knit.Services[serviceName].RE[eventName]
    end)
    local remote = ok and res or nil
    if useCache and remote then
        RemoteCache[key] = remote
    end
    return remote
end

local function clearCaches()
    RemoteCache = {}
    MoveSetCache = { char = nil, moves = {} }
    SendThrottle = {}
end

local function getMovesetChild(name)
    local char = LocalPlayer.Character
    if not char then return nil end
    local folder = char:FindFirstChild("Moveset")
    if not folder then return nil end

    if not useCache then
        return folder:FindFirstChild(name)
    end

    if MoveSetCache.char ~= char then
        MoveSetCache = { char = char, moves = {} }
    end

    local cached = MoveSetCache.moves[name]
    if cached and cached.Parent == folder then
        return cached
    end
    local child = folder:FindFirstChild(name)
    MoveSetCache.moves[name] = child
    return child
end

local function canSend(key, minInterval)
    local now = os.clock()
    local last = SendThrottle[key]
    if last and (now - last) < minInterval then
        return false
    end
    SendThrottle[key] = now
    return true
end

local function createFloatingHotkey(opts)
    if not isMobile then return nil end

    local old = PlayerGui:FindFirstChild(opts.guiName)
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = opts.guiName
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.Parent = PlayerGui

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(52, 52)
    btn.Position = opts.defaultPos
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    btn.BackgroundTransparency = 0.25
    btn.Text = "OFF"
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(0, 150, 255)
    stroke.Parent = btn

    local api = { gui = gui, btn = btn, fixed = true, visible = true, defaultPos = opts.defaultPos }

    api.refresh = function()
        local on = false
        pcall(function() on = opts.getState() end)
        if on then
            btn.Text = "ON"
            btn.BackgroundColor3 = Color3.fromRGB(0, 110, 60)
            btn.TextColor3 = Color3.fromRGB(235, 255, 240)
        else
            btn.Text = "OFF"
            btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
            btn.TextColor3 = Color3.fromRGB(220, 220, 220)
        end
        stroke.Color = api.fixed and Color3.fromRGB(255, 180, 0) or Color3.fromRGB(0, 150, 255)
        stroke.Thickness = api.fixed and 2 or 1.5
    end

    api.setVisible = function(state)
        api.visible = state
        gui.Enabled = state
    end

    api.setFixed = function(state)
        api.fixed = state
        api.refresh()
    end

    api.reset = function()
        btn.Position = api.defaultPos
    end

    local dragging, dragStart, startPos, moved = false, nil, nil, false

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = btn.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging or api.fixed then return end
        if input.UserInputType ~= Enum.UserInputType.Touch
            and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local delta = input.Position - dragStart
        if math.abs(delta.X) > 6 or math.abs(delta.Y) > 6 then moved = true end
        btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch
            and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not dragging then return end
        dragging = false
        if not moved then
            pcall(function() opts.onToggle() end)
            api.refresh()
        end
    end)

    api.refresh()
    return api
end

