task.spawn(function()
	while true do
		task.wait(0.03)
		if cfg.autoClap then
			local rightTarget = getClapTarget()
			if rightTarget then
				clapAt(TodoSwap, rightTarget, false)
			end
			task.wait(cfg.clapLeftSpeed)
			for i = 1, cfg.clapLeftTimes do
				local leftTarget = getClapTarget()
				if leftTarget then
					clapAt(TodoClap, leftTarget, true)
				end
				if i < cfg.clapLeftTimes then
					task.wait(cfg.clapLeftGap)
				end
			end
			task.wait(cfg.clapSpeed)
		end
	end
end)

