local function getPing()
	local okPing, value = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	if okPing and type(value) == "number" then
		return math.floor(value)
	end
	local ok2, value2 = pcall(function()
		return Stats.PerformanceStats.Ping:GetValue()
	end)
	if ok2 and type(value2) == "number" then
		return math.floor(value2)
	end
	return nil
end

