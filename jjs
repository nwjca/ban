local function findClosestPlayer()
    local closestDistance = math.huge
    local closestPlayer = nil
    local character = LocalPlayer.Character
    if not (character and character:FindFirstChild("HumanoidRootPart")) then
        return nil
    end
    local hrp = character.HumanoidRootPart
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local targetChar = player.Character
            if targetChar then
                local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
                local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
                if targetHRP and humanoid and humanoid.Health > 0 then
                    if nameAllowed(player, targetChar) then
                        local distance = (hrp.Position - targetHRP.Position).Magnitude
                        if distance < closestDistance then
                            closestDistance = distance
                            closestPlayer = player
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function facePlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then
        return false
    end
    local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local localHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if targetHRP and localHRP then
        local lookAt = (targetHRP.Position - localHRP.Position)
        lookAt = Vector3.new(lookAt.X, 0, lookAt.Z)
        if lookAt.Magnitude > 0.1 then
            localHRP.CFrame = CFrame.lookAt(localHRP.Position, localHRP.Position + lookAt)
            return true
        end
    end
    return false
end

