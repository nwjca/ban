end

local frameCount = 0
local fpsValue = 0

RunService.RenderStepped:Connect(function()
	frameCount = frameCount + 1
end)

local function getPing()
	local okPing, value = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	if okPing and type(value) == "number" then
		return math.floor(value)
	end
	local ok2, value2 = pcall(function()
		return Stats.PerformanceStats.Ping:GetValue()
	end)
	if ok2 and type(value2) == "number" then
		return math.floor(value2)
	end
	return nil
end

task.spawn(function()
	while true do
		task.wait(1)
		local ping = getPing()
		setText(pingLabel, pingShadow, "PING  " .. (ping and (tostring(ping) .. "ms") or "--"))
	end
end)

task.spawn(function()
	while true do
		task.wait(1)
		fpsValue = frameCount
		frameCount = 0
		setText(fpsLabel, fpsShadow, "FPS  " .. tostring(fpsValue))
	end
end)

