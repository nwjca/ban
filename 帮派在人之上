local autoAttackEnabled = false
local attackMode = "Stomp"
local attackInterval = 0
local orbitEnabled = true
local orbitRadius = 3
local orbitSpeed = 4
local maxDistance = 300

local orbitAngle = 0
local currentTarget = nil
local heartbeatConnection = nil

local function getLocalHRP()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getFightEvent()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end
    local fight = character:FindFirstChild("Fight")
    return fight and fight:FindFirstChild("FightEvent")
end

local function getTargetHRP(targetPlayer)
    local character = targetPlayer and targetPlayer.Character
    if not character then
        return nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart")
end

local function findClosestPlayer(limit)
    local hrp = getLocalHRP()
    if not hrp then
        return nil
    end

    local bestPlayer = nil
    local bestDistance = (limit and limit > 0) and limit or math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local targetHRP = getTargetHRP(player)
            if targetHRP then
                local distance = (hrp.Position - targetHRP.Position).Magnitude
                if distance < bestDistance then
                    bestDistance = distance
                    bestPlayer = player
                end
            end
        end
    end

    return bestPlayer
end

local function fireAttack(mode)
    local event = getFightEvent()
    if not event then
        return false
    end
    event:FireServer(mode)
    return true
end

local function teleportOrbit(hrp, targetHRP, dt)
    orbitAngle += orbitSpeed * dt
    orbitAngle %= math.pi * 2

    local center = Vector3.new(targetHRP.Position.X, hrp.Position.Y, targetHRP.Position.Z)
    local pos = center + Vector3.new(math.cos(orbitAngle)*orbitRadius, 0, math.sin(orbitAngle)*orbitRadius)
    hrp.CFrame = CFrame.lookAt(pos, center)
end

local function stopLoop()
    if heartbeatConnection then
        heartbeatConnection:Disconnect()
        heartbeatConnection = nil
    end
    currentTarget = nil
end

local function startLoop()
    stopLoop()
    heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not autoAttackEnabled then return end
        local hrp = getLocalHRP()
        if not hrp then return end

        local target = findClosestPlayer(maxDistance)
        currentTarget = target
        if not target then return end
        local targetHRP = getTargetHRP(target)
        if not targetHRP then return end

        if orbitEnabled then
            teleportOrbit(hrp, targetHRP, deltaTime)
        else
            local dir = Vector3.new(targetHRP.Position.X - hrp.Position.X,0,targetHRP.Position.Z - hrp.Position.Z)
            if dir.Magnitude>0.1 then
                hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position+dir)
            end
        end

        fireAttack(attackMode)
    end)
end

