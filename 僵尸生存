local function getGun()
    local ch = LP.Character
    if ch then
        local t = ch:FindFirstChild(C.Gun)
        if t then return t end
    end
    local bp = LP:FindFirstChild("Backpack")
    if bp then return bp:FindFirstChild(C.Gun) end
end

local function ensureGun()
    local g = getGun()
    if not g then return nil end
    if g.Parent ~= LP.Character then
        g.Parent = LP.Character
        task.wait()
    end
    return g
end

local function getHammer()
    local ch = LP.Character
    if ch then
        local t = ch:FindFirstChild(TOOL_HAMMER)
        if t then return t end
    end
    local bp = LP:FindFirstChild("Backpack")
    if bp then return bp:FindFirstChild(TOOL_HAMMER) end
end

local function isMate(p)
    if not C.Team then return false end
    if not LP.Team or not p.Team then return false end
    return p.Team == LP.Team
end

local function aim(ch)
    return ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
end

local function list()
    local r = {}
    if C.Plr then
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and p.Character and not isMate(p) then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                local a = aim(p.Character)
                if a and h and h.Health > 0 then
                    table.insert(r, { part = a, char = p.Character })
                end
            end
        end
    end
    if C.Npc then
        for _, o in ipairs(W:GetDescendants()) do
            if o:IsA("Model") and o ~= LP.Character and not P:GetPlayerFromCharacter(o) then
                local h = o:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    local a = aim(o)
                    if a then table.insert(r, { part = a, char = o }) end
                end
            end
        end
    end
    return r
end

local function best()
    local b, bd = nil, math.huge
    local ctr = Cam.ViewportSize / 2
    local ch = LP.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    for _, t in ipairs(list()) do
        local d = (t.part.Position - hrp.Position).Magnitude
        if d <= C.Dist then
            local sp, on = Cam:WorldToViewportPoint(t.part.Position)
            if on then
                local fd = (Vector2.new(sp.X, sp.Y) - ctr).Magnitude
                if fd <= C.Fov and d < bd then
                    bd = d
                    b = t
                end
            end
        end
    end
    return b
end

local function getOrigin(handle, firePoint)
    if firePoint then
        if firePoint:IsA("Attachment") then
            return firePoint.WorldPosition
        elseif firePoint:IsA("BasePart") then
            return firePoint.Position
        end
    end
    return handle.Position
end

local function Create3DTracer(startPos, endPos)
    if not C.Tracer3D then return end
    local distance = (startPos - endPos).Magnitude
    if distance < 1 then return end
    
    local tracer = Instance.new("Part")
    tracer.Name = "RageTracer3D"
    tracer.Anchored = true
    tracer.CanCollide = false
    tracer.CastShadow = false
    tracer.Material = Enum.Material.Neon
    tracer.Color = C.TracerColor
    tracer.Transparency = 0.3
    tracer.Size = Vector3.new(0.15, 0.15, distance)
    tracer.CFrame = CFrame.lookAt((startPos + endPos) / 2, endPos)
    
    tracer.Parent = workspace
    Debris:AddItem(tracer, 0.15)
end

local function fire(t)
    local g = C.AutoEquip and ensureGun() or getGun()
    if not g then return false end
    local h = g:FindFirstChild("Handle")
    if not h then return false end

    local fp = h:FindFirstChild("GunFirePoint")
    local mp = h:FindFirstChild("GunMuzzlePoint")
    local origin = getOrigin(h, fp)

    local diff = t.part.Position - origin
    if diff.Magnitude < 0.001 then return false end
    local dir = diff.Unit

    local hitPart = C.ForceHit and t.part or nil
    local hitPos = C.ForceHit and t.part.Position or nil

    Create3DTracer(origin, t.part.Position)

    pcall(function()
        VB:FireServer(
            g, h,
            hitPart,
            hitPos,
            { dir }, fp,
            { true, {}, 1, 1.5, 0.3, Hit, false },
            { true, {}, 1, 1, 0.3, Blood },
            { true, 0.4, {}, false, 9, 1 },
            { false, 8, true, {}, 1, 1.5, 1, false, Exp, false, true, 3, {}, false, 3, 1 },
            { "NewBullet", C.Spd, Vector3.new(0, 0, 0), C.Rng, C.Pen, false, 3, 0, 0, 0, 0 },
            { true, {}, 1, 1, 25, 1 },
            nil
        )
    end)

    if C.Muzzle and VM and mp then
        pcall(function()
            VM:FireServer(h, nil, true,
                { false, 4, Color3.new(1, 1.1098039150238037, 0), 15, true, 0.01 }, Muz, nil)
        end)
    end

    if C.Sound and PA and mp then
        pcall(function()
            PA:FireServer(
                { Pitch = 1, MaxDistance = 10000, Volume = 0.25, Silenced = false,
                  SoundId = "rbxassetid://11403268943", Muzzle = mp, Echo = true, EmitterSize = 70 },
                { Enabled = false, EmitterSize = 10, CurrentAmmo = 4, Muzzle = mp,
                  AmmoPerMag = 5, Volume = 0.5, SoundId = "rbxassetid://3032849569",
                  MaxDistance = 10000, Pitch = 1 },
                nil)
        end)
    end

    shots = shots + 1
    return true
end

local function draw(t)
    if not C.Line2D or not t then
        line2D.Visible = false
        return
    end
    local sp, on = Cam:WorldToViewportPoint(t.part.Position)
    if on then
        line2D.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
        line2D.To = Vector2.new(sp.X, sp.Y)
        line2D.Color = C.TracerColor
        line2D.Visible = true
    else
        line2D.Visible = false
    end
end

local function loop()
    while C.On do
        local t = best()
        tgt = t
        fov.Position = Cam.ViewportSize / 2
        fov.Radius = C.Fov
        fov.Visible = C.Circle and C.On
        if t then
            local now = tick()
            if now - last >= C.Interval then
                last = now
                fire(t)
            end
        end
        draw(t)
        R.RenderStepped:Wait()
    end
    fov.Visible = false
    line2D.Visible = false
    tgt = nil
    active = false
end

local function start()
    if active then return end
    active = true
    task.spawn(loop)
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if C.Reload and C.On then
            local g = getGun()
            if g then
                local gs = g:FindFirstChild("GunScript_Server")
                local cm = gs and gs:FindFirstChild("ChangeMagAndAmmo")
                if cm then pcall(function() cm:FireServer() end) end
            end
        end
    end
end)

-- ============ 自动修复建筑 ============
local repairParams = OverlapParams.new()
repairParams.FilterType = Enum.RaycastFilterType.Include
repairParams.MaxParts = 2000

local function isBarricade(part)
    if not part or not part:IsA("BasePart") then return false end
    local b = W:FindFirstChild("Barricades")
    if not b then return false end
    return part:IsDescendantOf(b)
end

local function isBroken(part)
    local hp = part:GetAttribute("Health") or part:GetAttribute("HP")
    local mx = part:GetAttribute("MaxHealth") or part:GetAttribute("MaxHP")
    if hp and mx and tonumber(hp) and tonumber(mx) then
        return tonumber(hp) < tonumber(mx)
    end
    return true
end

local function repairOne(tool, part, hrpPos)
    local diff = part.Position - hrpPos
    local dir = diff.Magnitude > 0.001 and diff.Unit or Vector3.new(0, 0, 1)
    local cf = CFrame.lookAt(part.Position, part.Position + dir)
    pcall(function() Repair:FireServer(tool, part, cf, C.RepairAmt) end)
    repairStats.n = repairStats.n + 1
    if C.RepairVisual and VH then
        local h = tool:FindFirstChild("Handle") or tool
        pcall(function()
            VH:FireServer(tool, h, part, part.Position, -dir, part.Material,
                { true, {}, 1, 1, 0.3, Hit, false },
                { true, {}, 1, 1, 0.3, Blood },
                { true, 0.5, {}, false, 3, 1 }, nil)
        end)
    end
end

local function repairLoop()
    while C.RepairOn do
        local tool = getHammer()
        local char = LP.Character
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
        local bar = W:FindFirstChild("Barricades")
        if tool and hrp and bar then
            repairParams.FilterDescendantsInstances = {bar}
            local parts = W:GetPartBoundsInRadius(hrp.Position, C.RepairRange, repairParams)
            repairStats.parts = #parts
            local n = 0
            for _, p in ipairs(parts) do
                if n >= C.RepairMax or not C.RepairOn then break end
                if isBarricade(p) and (not C.RepairOnlyBroken or isBroken(p)) then
                    repairOne(tool, p, hrp.Position)
                    n = n + 1
                end
            end
        end
        if C.RepairCd > 0 then task.wait(C.RepairCd) else R.RenderStepped:Wait() end
    end
    repairRunning = false
end

local function startRepair()
    if repairRunning then return end
    repairRunning = true
    task.spawn(repairLoop)
end

-- ============ 僵尸精准拆除路障 ============
local function getZombie()
    local ch = LP.Character
    if not ch then return nil end
    local z = ch:FindFirstChild("Zombie")
    if not z then return nil end
    local h = z:FindFirstChild("Handle") or z:FindFirstChildWhichIsA("BasePart")
    local hrp = ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
    return z, h, hrp
end

local attackParams = OverlapParams.new()
attackParams.FilterType = Enum.RaycastFilterType.Include -- 仅包含指定文件夹
attackParams.MaxParts = 500

local function attackLoop()
    local z, h, hrp = getZombie()
    if C.MuteMoan and z then
        local ms = z:FindFirstChild("MeleeScript_Server")
        if ms then
            local moan = ms:FindFirstChild("SoundMoan")
            local snd = ms:FindFirstChild("Sound")
            if moan then pcall(function() moan:FireServer("OFF") end) end
            if snd then pcall(function() snd:FireServer(true) end) end
        end
    end

    while C.AttackOn do
        local z, h, hrp = getZombie()
        local bar = W:FindFirstChild("Barricades")
        
        if z and hrp and bar and DamagedBarricade then
            -- 严格只搜索 Barricades 文件夹里的路障
            attackParams.FilterDescendantsInstances = {bar}
            local parts = W:GetPartBoundsInRadius(hrp.Position, C.AttackRange, attackParams)
            
            -- 过滤出真正的实体部件
            local validParts = {}
            for _, p in ipairs(parts) do
                if p:IsA("BasePart") then
                    -- 智能检测血量（如果路障已经碎了就不浪费时间发了）
                    local hp = p:GetAttribute("Health") or p:GetAttribute("HP") or p:GetAttribute("Durability")
                    if hp == nil or tonumber(hp) > 0 then
                        table.insert(validParts, p)
                    end
                end
            end
            
            -- 按距离排序，优先打离得最近的
            table.sort(validParts, function(a, b)
                return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
            end)

            local n = 0
            for _, p in ipairs(validParts) do
                if n >= C.AttackMax or not C.AttackOn then break end
                
                local diff = p.Position - hrp.Position
                local dir = diff.Magnitude > 0.001 and diff.Unit or Vector3.new(1, 0, 0)
                
                -- 发送真实伤害事件（参数完全对齐抓包）
                pcall(function()
                    DamagedBarricade:FireServer(z, p, p.CFrame, C.AttackForce, 1.2)
                end)
                
                -- 播放击中特效
                if C.AttackVisual and VH then
                    pcall(function()
                        VH:FireServer(z, h, p, p.Position, -dir, p.Material,
                            { true, {}, 1, 1, 0.3, Hit, false },
                            { true, {}, 1, 1, 0.3, Blood },
                            { true, 0.5, {}, false, 3, 1 }, true)
                    end)
                end
                
                attackStats.n = attackStats.n + 1
                n = n + 1
            end
        end
        -- 限制频率防延迟爆炸
        if C.AttackCd > 0 then task.wait(C.AttackCd) else task.wait(0.05) end
    end
    attackRunning = false
end

local function startAttack()
    if attackRunning then return end
    attackRunning = true
    task.spawn(attackLoop)
end

