                WindUI:Notify({ Title = "警告", Content = "未找到 DamagedBarricade 事件", Icon = "alert-triangle", Duration = 4 })
            end
            startAttack()
            WindUI:Notify({ Title = "拆路障已开启", Content = "正在摧毁周围路障...", Icon = "check", Duration = 2 })
        else
            WindUI:Notify({ Title = "拆路障已关闭", Icon = "x", Duration = 2 })
        end
    end
})

