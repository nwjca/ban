local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

WindUI.TransparencyValue = 0.2
WindUI:SetTheme("Dark")

local Window = WindUI:CreateWindow({
    Title = "idknamegg",
    Icon = "palette",
    Author = "上面大名称下面",
    Folder = "文件夹路径",
    Size = UDim2.fromOffset(700, 500),
    Theme = "Dark",
    SideBarWidth = 220,
    ScrollBarEnabled = true
})

local Tab = Window:Tab({
    Title = "注入",
    Icon = "download",
    Locked = false
})

local BASE = "https://raw.githubusercontent.com/nwjca/ban/refs/heads/main/"

local function loadRemote(name, path, desc)
    Tab:Button({
        Title = name,
        Desc = desc,
        Icon = "zap",
        Callback = function()
            local ok, err = pcall(function()
                loadstring(game:HttpGet(BASE .. path))()
            end)
            if ok then
                WindUI:Notify({ Title = name, Content = "脚本已加载", Duration = 2 })
            else
                WindUI:Notify({ Title = name .. " 失败", Content = tostring(err), Duration = 3 })
            end
        end
    })
end

