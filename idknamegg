-- 配置变量
local autoBlackFlash = false
local scanRange = 5
local skillCooldown = 1
local lastUsed = 0

local LocalPlayer = game:GetService("Players").LocalPlayer
local RunService = game:GetService("RunService")

-- 远程事件（沿用你原来的路径）
local DivergentFistEvent = game:GetService("ReplicatedStorage").Knit.Knit.Services.DivergentFistService.RE.Activated

local function IsValidTarget(hit)
    if not hit then return false end
    local model = hit:FindFirstAncestorOfClass("Model")
    if not model then return false end
    if model == LocalPlayer.Character then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function GetNearestTarget(range)
    local character = LocalPlayer.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local nearest, minDist = nil, range
    for _, obj in workspace:GetDescendants() do
        if obj:IsA("BasePart") and IsValidTarget(obj) then
            local targetModel = obj:FindFirstAncestorOfClass("Model")
            local targetRoot = targetModel:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                local dist = (root.Position - targetRoot.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = targetRoot
                end
            end
        end
    end
    return nearest
end

-- 主循环
RunService.RenderStepped:Connect(function()
    if not autoBlackFlash then return end
    local now = os.clock()
    if now - lastUsed < skillCooldown then return end

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local target = GetNearestTarget(scanRange)
    if not target then return end

    -- 传送至目标身后
    local behindCFrame = target.CFrame * CFrame.new(0, 0, -3)
    root.CFrame = behindCFrame

    -- 触发黑闪
    local moveSet = char:FindFirstChild("Moveset") and char.Moveset:FindFirstChild("Divergent Fist")
    if moveSet then
        DivergentFistEvent:FireServer(moveSet, nil)
    end
    lastUsed = now
end)

