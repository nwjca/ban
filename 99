            if char then
                for _, tool in ipairs(char:GetChildren()) do
                    if tool:IsA("Tool") and weaponNames[tool.Name] then
                        if InfiniteAmmoEnabled then
                            if not OriginalAmmoCache[tool] then
                                OriginalAmmoCache[tool] = {}
                                for _, attrName in ipairs({"Ammo", "Clip", "CurrentAmmo", "Mag"}) do
                                    local val = tool:GetAttribute(attrName)
                                    if type(val) == "number" then OriginalAmmoCache[tool][attrName] = val end
                                end
                                for _, child in ipairs(tool:GetDescendants()) do
                                    if child:IsA("ValueBase") and (child.Name == "Ammo" or child.Name == "Clip" or child.Name == "CurrentAmmo" or child.Name == "Mag") then
                                        if type(child.Value) == "number" then OriginalAmmoCache[tool][child] = child.Value end
                                    end
                                end
                            end
                        end
                        if FastFireRateEnabled then
                            if not OriginalFireRateCache[tool] then
                                OriginalFireRateCache[tool] = {}
                                for attrName, val in pairs(tool:GetAttributes()) do
                                    local lowerName = attrName:lower()
                                    if (lowerName:find("rate") or lowerName:find("delay") or lowerName:find("cooldown") or lowerName:find("time")) and type(val) == "number" then
                                        OriginalFireRateCache[tool][attrName] = val
                                    end
                                end
                                for _, child in ipairs(tool:GetDescendants()) do
                                    if child:IsA("ValueBase") and type(child.Value) == "number" then
                                        local lowerName = child.Name:lower()
                                        if lowerName:find("rate") or lowerName:find("delay") or lowerName:find("cooldown") or lowerName:find("time") then
                                            OriginalFireRateCache[tool][child] = child.Value
                                        end
                                    end
                                end
                            end
                            for attrName, val in pairs(tool:GetAttributes()) do
                                local lowerName = attrName:lower()
                                if (lowerName:find("rate") or lowerName:find("delay") or lowerName:find("cooldown") or lowerName:find("time")) and type(val) == "number" then
                                    tool:SetAttribute(attrName, lowerName:find("rate") and not lowerName:find("delay") and 999 or 0.001)
                                end
                            end
                            for _, child in ipairs(tool:GetDescendants()) do
                                if child:IsA("ValueBase") and type(child.Value) == "number" then
                                    local lowerName = child.Name:lower()
                                    if lowerName:find("rate") or lowerName:find("delay") or lowerName:find("cooldown") or lowerName:find("time") then
                                        child.Value = lowerName:find("rate") and not lowerName:find("delay") and 999 or 0.001
                                    end
                                end
                            end
                        end
                    end
                end
            end
            task.wait(0.1)
        else
            if next(OriginalAmmoCache) ~= nil then
                for tool, data in pairs(OriginalAmmoCache) do
                    if tool and tool.Parent then
                        for key, val in pairs(data) do
                            if type(key) == "string" then tool:SetAttribute(key, val)
                            elseif typeof(key) == "Instance" and key.Parent then key.Value = val end
                        end
                    end
                end
                OriginalAmmoCache = {}
            end
            if next(OriginalFireRateCache) ~= nil then
                for tool, data in pairs(OriginalFireRateCache) do
                    if tool and tool.Parent then
                        for key, val in pairs(data) do
                            if type(key) == "string" then tool:SetAttribute(key, val)
                            elseif typeof(key) == "Instance" and key.Parent then key.Value = val end
                        end
                    end
                end
                OriginalFireRateCache = {}
            end
            task.wait(0.5)
        end
    end
end)

