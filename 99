local function RestoreMorph()
    if MorphApplied and OriginalAppearanceData then
        local myChar = LocalPlayer.Character
        if myChar then
            for _, v in pairs(myChar:GetChildren()) do
                if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") then 
                    v:Destroy() 
                end
            end
            for _, acc in ipairs(OriginalAppearanceData.Accessories) do
                acc:Clone().Parent = myChar
            end
            if OriginalAppearanceData.Shirt then
                local s = Instance.new("Shirt"); s.ShirtTemplate = OriginalAppearanceData.Shirt; s.Parent = myChar
            end
            if OriginalAppearanceData.Pants then
                local p = Instance.new("Pants"); p.PantsTemplate = OriginalAppearanceData.Pants; p.Parent = myChar
            end
            if OriginalAppearanceData.BodyColors then
                OriginalAppearanceData.BodyColors:Clone().Parent = myChar
            end
            if OriginalAppearanceData.BodyScale then
                OriginalAppearanceData.BodyScale:Clone().Parent = myChar
            end
        end
        MorphApplied = false
        if MorphLoopConnection then MorphLoopConnection:Disconnect(); MorphLoopConnection = nil end
        WindUI:Notify({ Title = "换肤", Content = "已恢复原本模样", Duration = 1.5 })
    end
end

local function ApplyMorph(name)
    if not name or name == "" then return end
    local target = Players:FindFirstChild(name)
    if not target or target == LocalPlayer then return end
    if not target.Character then
        WindUI:Notify({ Title = "错误", Content = "该玩家的角色尚未加载", Duration = 2 })
        return
    end
    
    local myChar = LocalPlayer.Character
    local tChar = target.Character
    if not myChar then return end
    
    RestoreMorph()
    
    OriginalAppearanceData = { Accessories = {}, Shirt = nil, Pants = nil, BodyColors = nil, BodyScale = nil }
    for _, v in pairs(myChar:GetChildren()) do
        if v:IsA("Accessory") then table.insert(OriginalAppearanceData.Accessories, v:Clone()) end
        if v:IsA("Shirt") then OriginalAppearanceData.Shirt = v.ShirtTemplate end
        if v:IsA("Pants") then OriginalAppearanceData.Pants = v.PantsTemplate end
        if v:IsA("BodyColors") then OriginalAppearanceData.BodyColors = v:Clone() end
        if v:IsA("BodyScale") then OriginalAppearanceData.BodyScale = v:Clone() end
    end
    
    local function DoClone()
        if not MorphApplied then return end
        local currentTChar = target.Character
        if not currentTChar then return end
        
        for _, v in pairs(myChar:GetChildren()) do
            if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") or v:IsA("BodyScale") then 
                v:Destroy() 
            end
        end
        
        for _, v in pairs(currentTChar:GetChildren()) do
            if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") or v:IsA("BodyScale") then
                local cloned = v:Clone()
                cloned.Parent = myChar
            end
        end
        
        local seenAttachments = {}
        for _, v in pairs(myChar:GetChildren()) do
            if v:IsA("Accessory") then
                local att = v:FindFirstChildOfClass("Attachment")
                if att then
                    if seenAttachments[att.Name] then
                        v:Destroy()
                    else
                        seenAttachments[att.Name] = true
                    end
                end
            end
        end
    end
    
    MorphApplied = true
    DoClone()
    
    if MorphLoopConnection then MorphLoopConnection:Disconnect() end
    MorphLoopConnection = task.spawn(function()
        while MorphApplied do
            task.wait(1)
            if MorphApplied then DoClone() end
        end
    end)
    
    WindUI:Notify({ Title = "本地换肤", Content = "已变成 " .. target.Name .. " (仅自己可见)", Duration = 2 })
end

