local function getRole(player)
    if player.Team then return player.Team.Name end
    local a = player:GetAttribute("Role")
    if a then return tostring(a) end
    local char = player.Character
    if char and char.Parent then
        local ca = char:GetAttribute("Role")
        if ca then return tostring(ca) end
    end
    return "Unknown"
end

local function getColor(player)
    local role = getRole(player)
    return ROLE_COLORS[role] or ROLE_COLORS["Unknown"]
end

local function makeTag(player, character)
    local head = character:WaitForChild("Head", 5)
    if not head then return end
    local old = head:FindFirstChild("MyIdentityTag")
    if old then old:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = "MyIdentityTag"
    bb.Size = UDim2.new(0, 85, 0, 28)
    bb.StudsOffset = Vector3.new(0, 2.2, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = math.huge
    bb.Adornee = head
    bb.Parent = head

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(1, 0, 0.45, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.TextScaled = true
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextStrokeTransparency = 0.2
    nameLbl.TextColor3 = Color3.new(1, 1, 1)
    nameLbl.Parent = bb

    local roleLbl = Instance.new("TextLabel")
    roleLbl.Position = UDim2.new(0, 0, 0.45, 0)
    roleLbl.Size = UDim2.new(1, 0, 0.35, 0)
    roleLbl.BackgroundTransparency = 1
    roleLbl.TextScaled = true
    roleLbl.Font = Enum.Font.GothamBold
    roleLbl.TextStrokeTransparency = 0.2
    roleLbl.Parent = bb

    local hpBack = Instance.new("Frame")
    hpBack.Position = UDim2.new(0.1, 0, 0.85, 0)
    hpBack.Size = UDim2.new(0.8, 0, 0.08, 0)
    hpBack.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    hpBack.BorderSizePixel = 0
    hpBack.Parent = bb

    local hpFill = Instance.new("Frame")
    hpFill.Size = UDim2.new(1, 0, 1, 0)
    hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
    hpFill.BorderSizePixel = 0
    hpFill.Parent = hpBack
    
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 2); corner.Parent = hpBack
    local fillCorner = Instance.new("UICorner"); fillCorner.CornerRadius = UDim.new(0, 2); fillCorner.Parent = hpFill

    local function refresh()
        if not bb.Parent then return end
        local role = getRole(player)
        nameLbl.Text = player.DisplayName
        roleLbl.Text = role
        roleLbl.TextColor3 = getColor(player)
    end

    local function updateHealth()
        local hum = character:FindFirstChildOfClass("Humanoid")
        if hum then
            local percent = hum.Health / hum.MaxHealth
            hpFill.Size = UDim2.new(percent, 0, 1, 0)
            if percent > 0.6 then hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
            elseif percent > 0.3 then hpFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
            else hpFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50) end
        end
    end

    refresh(); updateHealth()
    player:GetAttributeChangedSignal("Role"):Connect(refresh)
    player:GetPropertyChangedSignal("Team"):Connect(refresh)
    local hum = character:WaitForChild("Humanoid", 5)
    if hum then hum.HealthChanged:Connect(updateHealth) end
    Tags[player] = bb
end

local function removeTag(player)
    local tag = Tags[player]
    if tag then tag:Destroy(); Tags[player] = nil end
    local char = player.Character
    local head = char and char:FindFirstChild("Head")
    local t2 = head and head:FindFirstChild("MyIdentityTag")
    if t2 then t2:Destroy() end
end

local function updateRender(player, char)
    if not char or not char.Parent then return end
    if not ESP.HighlightEnabled then
        if Highlights[player] then pcall(function() Highlights[player]:Destroy() end); Highlights[player] = nil end
        return
    end
    local hl = Highlights[player]
    if not hl or hl.Parent ~= char then
