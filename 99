end

local function CreateGreenTracer(startPos, endPos)
    local distance = (startPos - endPos).Magnitude
    if distance < 1 then return end
    local dir = (endPos - startPos).Unit
    local right = dir:Cross(Vector3.new(0, 1, 0))
    if right.Magnitude < 0.01 then right = dir:Cross(Vector3.new(1, 0, 0)) end
    right = right.Unit
    local up = dir:Cross(right).Unit

    local SEGMENTS, AMPLITUDE, FREQUENCY, WAVE_SPEED, DURATION = 20, 1.2, 3.5, 10, 0.9
    local segments = {}
    for i = 1, SEGMENTS do
        local seg = Instance.new("Part")
        seg.Name, seg.Anchored, seg.CanCollide, seg.CastShadow = "GreenTracerWave", true, false, false
        seg.Material, seg.Color, seg.Transparency, seg.Size = Enum.Material.Neon, Color3.fromRGB(0, 255, 0), 0.2, Vector3.new(0.15, 0.15, 0.5)
        seg.Parent = workspace
        segments[i] = seg
    end

    local startTime = os.clock()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local elapsed = os.clock() - startTime
        if elapsed > DURATION then
            conn:Disconnect()
            for _, seg in ipairs(segments) do if seg.Parent then seg:Destroy() end end
            return
        end
        local transparency = 0.2 + (elapsed / DURATION) * 0.8
        for i = 1, SEGMENTS do
            local seg = segments[i]
            if not seg.Parent then return end
            local t1, t2 = (i - 1) / SEGMENTS, i / SEGMENTS
            local base1, env1 = startPos + dir * (distance * t1), math.sin(t1 * math.pi)
            local phase1 = t1 * FREQUENCY * math.pi * 2 - elapsed * WAVE_SPEED
            local p1 = base1 + (right * (math.sin(phase1) * AMPLITUDE) + up * (math.cos(phase1 * 0.8) * AMPLITUDE * 0.6)) * env1
            local base2, env2 = startPos + dir * (distance * t2), math.sin(t2 * math.pi)
            local phase2 = t2 * FREQUENCY * math.pi * 2 - elapsed * WAVE_SPEED
            local p2 = base2 + (right * (math.sin(phase2) * AMPLITUDE) + up * (math.cos(phase2 * 0.8) * AMPLITUDE * 0.6)) * env2
            local mid, len = (p1 + p2) / 2, (p2 - p1).Magnitude
            if len > 0.01 then
                seg.CFrame = CFrame.lookAt(mid, p2) * CFrame.new(0, 0, -len / 2)
                seg.Size = Vector3.new(0.15, 0.15, len * 1.15)
            end
            seg.Transparency = transparency
        end
    end)
    task.delay(DURATION + 0.1, function()
        if conn then conn:Disconnect() end
        for _, seg in ipairs(segments) do if seg.Parent then seg:Destroy() end end
    end)
end

local function PlayRageEffects(soundEnabled, tracerEnabled, targetPos)
    if not IsHoldingGun() then return end
    local now = tick()
    if now - LastRageShotTime < 0.05 then return end
    LastRageShotTime = now
    if soundEnabled then PlayAttackSound() end
    if tracerEnabled then CreateGreenTracer(GetMuzzlePosition(), targetPos or (Camera.CFrame.Position + Camera.CFrame.LookVector * 500)) end
end

local function GetWeaponAmmo(tool)
    if not tool then return nil end
    local attrAmmo = tool:GetAttribute("Ammo") or tool:GetAttribute("Clip") or tool:GetAttribute("CurrentAmmo") or tool:GetAttribute("Mag")
    if type(attrAmmo) == "number" then return attrAmmo end
    local ammoVal = tool:FindFirstChild("Ammo") or tool:FindFirstChild("Clip") or tool:FindFirstChild("CurrentAmmo") or tool:FindFirstChild("Mag")
    if ammoVal and ammoVal:IsA("ValueBase") then return ammoVal.Value end
    for _, v in ipairs(tool:GetDescendants()) do
        if v.Name == "Ammo" or v.Name == "Clip" or v.Name == "CurrentAmmo" or v.Name == "Mag" then
            if v:IsA("ValueBase") then return v.Value end
        end
    end
    return nil
end

local function IsWeaponReady()
    if InfiniteAmmoEnabled then return true end
    local char = LocalPlayer.Character
    if not char then return false end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and weaponNames[child.Name] then
            local ammo = GetWeaponAmmo(child)
            if ammo == nil then return true end
            return ammo > 0
        end
    end
    return false
end

