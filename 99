local function AddHitLog(targetName, partName, damage)
    logCounter = logCounter + 1
    
    local currentLogs = LogContainer:GetChildren()
    local labelCount = 0
    for _, child in ipairs(currentLogs) do
        if child:IsA("TextLabel") then labelCount = labelCount + 1 end
    end
    if labelCount >= MAX_LOGS then
        for _, child in ipairs(currentLogs) do
            if child:IsA("TextLabel") and child.LayoutOrder == (logCounter - MAX_LOGS) then
                child:Destroy()
                break
            end
        end
    end
    
    local logLabel = Instance.new("TextLabel")
    logLabel.Name = "HitLog"
    logLabel.Size = UDim2.new(0, 0, 0, 14)
    logLabel.AutomaticSize = Enum.AutomaticSize.X
    logLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    logLabel.BackgroundTransparency = HitFeedbackTransparency
    logLabel.Font = Enum.Font.Arcade
    logLabel.TextSize = 11
    logLabel.TextColor3 = HitFeedbackColor
    logLabel.TextStrokeTransparency = 0
    logLabel.TextStrokeColor3 = Color3.fromRGB(255, 255, 255)
    logLabel.TextXAlignment = Enum.TextXAlignment.Left
    logLabel.LayoutOrder = logCounter
    
    logLabel.Text = string.format(" HIT %s | %s | %d DMG ", 
        targetName:upper(), 
        partName:upper(), 
        damage
    )
    
    local padding = Instance.new("UIPadding")
