local MUZZLE_KEYWORDS = { "muzzle", "barrel", "firepoint", "fire_point", "tip", "nozzle", "flash", "gunpoint", "shootpoint", "emitter", "origin" }

local function GetMuzzlePosition()
    local char = LocalPlayer.Character
    if not char then return Camera.CFrame.Position end
    
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and weaponNames[child.Name] then
            local tool = child
            local bestPart, bestPriority = nil, math.huge
            
            for _, desc in ipairs(tool:GetDescendants()) do
                if desc:IsA("BasePart") then
                    local lower = desc.Name:lower()
                    for idx, kw in ipairs(MUZZLE_KEYWORDS) do
                        if lower:find(kw) then
                            if idx < bestPriority then bestPriority = idx; bestPart = desc end
                            break
                        end
                    end
                end
            end
            if bestPart then return bestPart.Position + bestPart.CFrame.LookVector * 0.2 end
            
            local handle = tool:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then return handle.Position + handle.CFrame.LookVector * 1.5 end
        end
    end
    return Camera.CFrame.Position
end

