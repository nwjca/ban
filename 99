local function GetTargetPlayer(checkWalls, fovRadius, useFov)
    local myChar = LocalPlayer.Character
    if not myChar then return nil, nil end
    local myRole = getRole(LocalPlayer)
    local cameraPos = Camera.CFrame.Position
    local screenCenter = Camera.ViewportSize / 2
    
    local function evaluate(p)
        if p == LocalPlayer or not p.Character or IsRageWhitelisted(p) then return nil end
        local role = getRole(p)
        local isAllowedRole = false
        if myRole == "Criminal" or myRole == "罪犯" then
            if role == "Civilian" or role == "平民" or role == "Police" or role == "警察" then isAllowedRole = true end
        elseif myRole == "Police" or role == "警察" then
            if role == "Criminal" or role == "罪犯" then isAllowedRole = true end
        end
        if not isAllowedRole then return nil end
        
        local tChar = p.Character
        local tHum = tChar:FindFirstChildOfClass("Humanoid")
        if not tHum or tHum.Health <= 0 then return nil end
        
        local part = tChar:FindFirstChild(RagebotAimPart) 
        if not part then part = tChar:FindFirstChild("HumanoidRootPart") end
        if not part then part = tChar:FindFirstChild("Head") end
        if not part then return nil end
        
        if useFov then
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen or (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude > fovRadius then return nil end
        end
        
        if checkWalls then
            CachedRaycastParams.FilterDescendantsInstances = {myChar, tChar, Camera}
            local visible = false
            local visiblePart = nil
            local checkParts = { "Head", "UpperTorso", "Torso", "HumanoidRootPart" }
            
            for _, pName in ipairs(checkParts) do
                local cp = tChar:FindFirstChild(pName)
                if cp then
                    local ray = workspace:Raycast(cameraPos, cp.Position - cameraPos, CachedRaycastParams)
                    if not ray then
                        visible = true
                        if cp == part then
                            visiblePart = part
                            break 
                        end
                        if not visiblePart then 
                            visiblePart = cp 
                        end
                    end
                end
            end
            
            if not visible then return nil end
            part = visiblePart 
        end
        
        return part, (cameraPos - part.Position).Magnitude
    end
    
    if RagePriorityEnabled and next(RagePriorityList) ~= nil then
        local bestPlayer, bestPart, bestDist = nil, nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if IsRagePriority(p) then
                local part, dist = evaluate(p)
                if part and dist < bestDist then bestPlayer, bestPart, bestDist = p, part, dist end
            end
        end
        if bestPlayer then return bestPlayer, bestPart, bestDist end
    end
    
    local closestPlayer, closestPart, closestDist = nil, nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        local part, dist = evaluate(p)
        if part and dist < closestDist then closestPlayer, closestPart, closestDist = p, part, dist end
    end
    return closestPlayer, closestPart, closestDist
end

