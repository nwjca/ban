function refreshBalls()
	DoorBall.Visible = opts.BallShow and opts.DoorBall
	PoseBall.Visible = opts.BallShow and opts.PoseBall
	AimBall.Visible = opts.BallShow and opts.AimBall

	DoorBall.BackgroundColor3 = opts.DoorAuto and Color3.fromRGB(45, 110, 70) or Color3.fromRGB(38, 38, 46)
	balls[DoorBall].stroke.Color = opts.DoorAuto and Color3.fromRGB(120, 220, 150) or Color3.fromRGB(95, 95, 110)

	PoseBall.BackgroundColor3 = opts.PoseOn and Color3.fromRGB(45, 110, 70) or Color3.fromRGB(38, 38, 46)
	balls[PoseBall].stroke.Color = opts.PoseOn and Color3.fromRGB(120, 220, 150) or Color3.fromRGB(95, 95, 110)

	AimBall.BackgroundColor3 = opts.AimOn and Color3.fromRGB(110, 60, 60) or Color3.fromRGB(38, 38, 46)
	balls[AimBall].stroke.Color = opts.AimOn and Color3.fromRGB(240, 120, 120) or Color3.fromRGB(95, 95, 110)
end

