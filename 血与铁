local function getChar()
	local char = LP.Character or LP.CharacterAdded:Wait()
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then return nil end
	return char
end

local function getHRP()
	local char = getChar()
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
end

local function getList()
	local t = {}
	if not GC then return t end
	for _, obj in ipairs(GC:GetChildren()) do
		local c = obj:FindFirstChild("ConstructCentre")
		if c and c:IsA("BasePart") then
			t[#t + 1] = {Name = obj.Name, Centre = c, Model = obj}
		end
	end
	return t
end

local function nearest(filterName, maxDist)
	local hrp = getHRP()
	if not hrp then return nil, math.huge end
	local best, bestD = nil, math.huge
	for _, item in ipairs(getList()) do
		if filterName == "最近的一个" or item.Name == filterName then
			local d = (item.Centre.Position - hrp.Position).Magnitude
			if (maxDist == 0 or d <= maxDist) and d < bestD then
				best, bestD = item, d
			end
		end
	end
	return best, bestD
end

local function otherTool(name)
	if name == "Hammer" then return "Shovel" end
	if name == "Shovel" then return "Hammer" end
	return "Hammer"
end

local function resolveTool(structName, index)
	local primary = opts.Tool
	if opts.AutoTool then
		if string.find(structName, "Barricade") or string.find(structName, "Wall") or string.find(structName, "Crate") then
			primary = "Hammer"
		elseif string.find(structName, "Earthwork") or string.find(structName, "Trench") or string.find(structName, "Dirt") then
			primary = "Shovel"
		end
	end
	if not opts.AltSwitch then return primary end
	if index % 2 == 0 then return primary end
	return otherTool(primary)
end

local function forceEquip(name)
	local char = getChar()
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end

	hum:UnequipTools()
	task.wait(0.12)

	char = LP.Character
	if not char then return nil end
	local bp = LP:FindFirstChild("Backpack")
	if not bp then return nil end
	local tool = bp:FindFirstChild(name)
	if not tool then
		local held = char:FindFirstChild(name)
		if held then return held end
		warn("背包里没有 " .. name)
		return nil
	end

	hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end
	hum:EquipTool(tool)

	for _ = 1, 8 do
		local t = char:FindFirstChild(name)
		if t then return t end
		task.wait(0.04)
	end
	return char:FindFirstChild(name)
end

local function repairCycle(item)
	if not item or not RequestDamage then return end
	local hrp = getHRP()
	if not hrp then return end
	if (item.Centre.Position - hrp.Position).Magnitude > (opts.MaxDist == 0 and 999 or opts.MaxDist + 1) then return end

	local toolName = resolveTool(item.Name, swingIndex)
	local tool = forceEquip(toolName)
	if not tool then return end

	local centre = item.Centre

	if opts.Animate and ReplicateAnimation then
		ReplicateAnimation:FireServer("Tool", toolName, "IdleToSwing")
		task.wait(0.1)
		ReplicateAnimation:FireServer("Effect", toolName, "Construct")
	end

	RequestDamage:FireServer(centre, centre.Position, tool, "ConstructMelee", -1)

	if opts.Animate and ReplicateAnimation then
		task.wait(0.08)
		ReplicateAnimation:FireServer("Tool", toolName, "SwingToIdle")
	end

	swingIndex = swingIndex + 1
end

local function startLoop()
	if running then return end
	running = true
	task.spawn(function()
		while running do
			local t0 = os.clock()
			local ok, err = pcall(function()
				local item = nearest(opts.Mode, opts.MaxDist)
				repairCycle(item)
			end)
			if not ok then
				warn("循环异常：" .. tostring(err))
				forceEquip(opts.Tool)
				task.wait(0.5)
			end
			local rest = opts.Interval - (os.clock() - t0)
			if rest > 0 then task.wait(rest) end
		end
	end)
end

local function stopLoop()
	running = false
end

local function doorPart(obj)
	if obj:IsA("BasePart") then return obj end
	return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function fireDoors()
	if not Doors then return end
	local char = LP.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local now = os.clock()
	for _, obj in ipairs(Doors:GetChildren()) do
		local ev = obj:FindFirstChild("Interact")
		if ev and ev:IsA("RemoteEvent") then
			local part = doorPart(obj)
			local near = true
			if part and hrp then
				near = (part.Position - hrp.Position).Magnitude <= opts.DoorDist
			end
			if near and (now - (doorLast[obj] or 0) >= opts.DoorCd) then
				doorLast[obj] = now
				pcall(function() ev:FireServer() end)
			end
		end
	end
end

local function doorStart()
	if doorRunning then return end
	doorRunning = true
	task.spawn(function()
		while doorRunning do
			local ok, err = pcall(fireDoors)
			if not ok then warn("开门异常：" .. tostring(err)) end
			task.wait(opts.DoorScan)
		end
	end)
end

local function doorStop()
	doorRunning = false
end

local function setDoor(state)
	opts.DoorAuto = state
	if state then doorStart() else doorStop() end
end

local function poseHook()
	local char = LP.Character
	local neck = char and char:FindFirstChild("Neck", true)
	if neck == poseCache.neck and neckConn then return end
	if neckConn then
		pcall(function() neckConn:Disconnect() end)
		neckConn = nil
	end
	poseCache.char = char
	poseCache.neck = neck
	if not neck then return end
	poseCache.n0 = neck.C0
	poseCache.base = CFrame.new(0, 1, 0) * R6_NECK_BASE
	neckConn = neck:GetPropertyChangedSignal("C0"):Connect(function()
		if opts.PoseOn and not applying then
			poseApply()
		end
	end)
end

local function poseApply()
	if not opts.PoseOn or applying then return end
	poseHook()
	local neck = poseCache.neck
	if not neck or not poseCache.base then return end
	applying = true
	neck.C0 = CFrame.Angles(math.rad(opts.Pitch), 0, 0) * poseCache.base
	applying = false
end

local function poseRestore()
	if poseCache.neck and poseCache.n0 then
		applying = true
		poseCache.neck.C0 = poseCache.n0
		applying = false
	end
end

RunService.Stepped:Connect(function()
	if opts.PoseOn then
		pcall(poseApply)
	end
end)

local function poseBind()
	pcall(function() RunService:UnbindFromRenderStep(POSE_RENDER) end)
	RunService:BindToRenderStep(POSE_RENDER, 301, poseApply)
end

local function poseUnbind()
	pcall(function() RunService:UnbindFromRenderStep(POSE_RENDER) end)
end

local function setPose(state)
	opts.PoseOn = state
	if state then
		poseHook()
		poseApply()
		poseBind()
	else
		poseUnbind()
		poseRestore()
	end
end

local function validTarget(pl)
	if pl == LP then return nil end
	local char = pl.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	local head = char:FindFirstChild("Head")
	if not head then return nil end
	if opts.AimTeam and LP.Team and pl.Team then
		if pl.Team == LP.Team then return nil end
	end
	return head
end

local function hasLOS(cam, char, head)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {LP.Character, cam}
	local res = workspace:Raycast(cam.CFrame.Position, head.Position - cam.CFrame.Position, rp)
	if not res then return true end
	return res.Instance:IsDescendantOf(char)
end

local function pickAimTarget()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local vp = cam.ViewportSize
	local center = Vector2.new(vp.X / 2, vp.Y / 2)
	local best, bestD = nil, math.huge
	for _, pl in ipairs(Players:GetPlayers()) do
		local head = validTarget(pl)
		if head then
			local sp, onScreen = cam:WorldToViewportPoint(head.Position)
			if onScreen and sp.Z > 0 then
				local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
				if d <= opts.AimFov and d < bestD then
					if opts.AimWall then
						if hasLOS(cam, pl.Character, head) then
							best, bestD = {char = pl.Character, head = head}, d
						end
					else
						best, bestD = {char = pl.Character, head = head}, d
					end
				end
			end
		end
	end
	return best
end

local hookOk = pcall(function()
	local oldIndex
	oldIndex = hookmetamethod(game, "__index", function(t, k)
		if aimTarget and t == mouse then
			if k == "Hit" then
				return CFrame.new(aimTarget.head.Position)
			elseif k == "Target" then
				return aimTarget.head
			elseif k == "UnitRay" then
				local cam = workspace.CurrentCamera
				if cam then
					return Ray.new(cam.CFrame.Position, (aimTarget.head.Position - cam.CFrame.Position).Unit)
				end
			end
		end
		return oldIndex(t, k)
	end)
end)

if not hookOk then
	warn("沉默瞄准 Hook 失败，当前执行器可能不支持 hookmetamethod")
end

