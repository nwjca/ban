UIS.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.K then
		setDoor(not opts.DoorAuto)
		pcall(function() DoorToggle:Set(opts.DoorAuto) end)
		refreshBalls()
	elseif input.KeyCode == Enum.KeyCode.T then
		setPose(not opts.PoseOn)
		pcall(function() PoseToggle:Set(opts.PoseOn) end)
		refreshBalls()
	elseif input.KeyCode == Enum.KeyCode.F then
		opts.AimOn = not opts.AimOn
		if not opts.AimOn then aimTarget = nil end
		pcall(function() AimToggle:Set(opts.AimOn) end)
		refreshBalls()
	end
end)

LP.CharacterAdded:Connect(function()
	poseCache.neck = nil
	if opts.PoseOn then
		poseHook()
		poseApply()
		poseBind()
	end
end)

RunService.RenderStepped:Connect(function()
	if not opts.AimOn then
		aimTarget = nil
		return
	end
	local ok, t = pcall(pickAimTarget)
	aimTarget = ok and t or nil
end)

refreshBalls()

task.spawn(function()
	while task.wait(0.4) do
		local item, d = nearest(opts.Mode, opts.MaxDist)
		if running then
			if item then
				RunToggle:SetDesc(string.format("目标 %s  距离 %.1f  下一把 %s", item.Name, d, resolveTool(item.Name, swingIndex)))
			else
				RunToggle:SetDesc("范围内无目标，走两步再试")
			end
		else
			RunToggle:SetDesc("未启动")
		end
	end
end)
