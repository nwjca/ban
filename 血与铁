task.spawn(function()
	local lastList = nil
	local acc = 0
	while true do
		local dt = task.wait(0.2)
		if opts.AutoList then
			acc = acc + dt
			if acc >= opts.ListDelay then
				acc = 0
				local list = voteListNow()
				local key = table.concat(list, "|")
				if key ~= lastList then
					lastList = key
					VoteDropdown:Refresh(list)
				end
			end
		else
			acc = 0
		end
	end
end)
