local function makeBall(title, text, pos, onClick)
	local btn = Instance.new("TextButton")
	btn.Name = title
	btn.Size = UDim2.fromOffset(opts.BallSize, opts.BallSize)
	btn.Position = pos
	btn.AnchorPoint = Vector2.new(1, 0)
	btn.BackgroundColor3 = Color3.fromRGB(38, 38, 46)
	btn.BackgroundTransparency = 0.15
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = math.floor(opts.BallSize * 0.36)
	btn.TextColor3 = Color3.fromRGB(235, 235, 235)
	btn.Text = text
	btn.Active = true

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Color = Color3.fromRGB(95, 95, 110)
	stroke.Transparency = 0.15
	stroke.Parent = btn

	btn.Parent = ballGui

	btn.Activated:Connect(function()
		onClick()
	end)

	balls[btn] = {stroke = stroke}
	return btn
end

local function ballPos(index, size)
