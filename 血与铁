UIS.InputChanged:Connect(function(input)
	if not dragState then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
	local btn = dragState.btn
	local delta = input.Position - dragState.start

	if not dragState.moved then
		if delta.Magnitude > 8 then
			dragState.moved = true
			if not dragState.switched then
				local abs = btn.AbsolutePosition
				btn.AnchorPoint = Vector2.new(0, 0)
				btn.Position = UDim2.fromOffset(abs.X, abs.Y)
				dragState.switched = true
				dragState.base = Vector2.new(abs.X, abs.Y)
				dragState.start = input.Position
			end
		end
	end

	if dragState.moved then
		local move = input.Position - dragState.start
		local maxX = math.max(ballGui.AbsoluteSize.X - btn.AbsoluteSize.X, 0)
		local maxY = math.max(ballGui.AbsoluteSize.Y - btn.AbsoluteSize.Y, 0)
		btn.Position = UDim2.fromOffset(
			math.clamp(dragState.base.X + move.X, 0, maxX),
			math.clamp(dragState.base.Y + move.Y, 0, maxY)
		)
	end
end)

UIS.InputEnded:Connect(function(input)
	if not dragState then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local moved = dragState.moved
		dragState = nil
		if not moved then
			local ok, err = pcall(fireDoors)
			if not ok then warn("开门异常：" .. tostring(err)) end
			doorBall.BackgroundColor3 = Color3.fromRGB(45, 110, 70)
			task.delay(0.25, function()
				doorBall.BackgroundColor3 = Color3.fromRGB(38, 38, 46)
			end)
		end
	end
end)

