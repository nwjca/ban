local function getChar()
	local char = LP.Character or LP.CharacterAdded:Wait()
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then return nil end
	return char
end

local function getHRP()
	local char = getChar()
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
end

local function getList()
	local t = {}
	if not GC then return t end
	for _, obj in ipairs(GC:GetChildren()) do
		local c = obj:FindFirstChild("ConstructCentre")
		if c and c:IsA("BasePart") then
			t[#t + 1] = {Name = obj.Name, Centre = c, Model = obj}
		end
	end
	return t
end

local function nearest(filterName, maxDist)
	local hrp = getHRP()
	if not hrp then return nil, math.huge end
	local best, bestD = nil, math.huge
	for _, item in ipairs(getList()) do
		if filterName == "最近的一个" or item.Name == filterName then
			local d = (item.Centre.Position - hrp.Position).Magnitude
			if (maxDist == 0 or d <= maxDist) and d < bestD then
				best, bestD = item, d
			end
		end
	end
	return best, bestD
end

local function otherTool(name)
	if name == "Hammer" then return "Shovel" end
	if name == "Shovel" then return "Hammer" end
	return "Hammer"
end

local function resolveTool(structName, index)
	local primary = opts.Tool
	if opts.AutoTool then
		if string.find(structName, "Barricade") or string.find(structName, "Wall") or string.find(structName, "Crate") then
			primary = "Hammer"
		elseif string.find(structName, "Earthwork") or string.find(structName, "Trench") or string.find(structName, "Dirt") then
			primary = "Shovel"
		end
	end
	if not opts.AltSwitch then return primary end
	if index % 2 == 0 then return primary end
	return otherTool(primary)
end

local function forceEquip(name)
	local char = getChar()
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end

	hum:UnequipTools()
	task.wait(0.12)

	char = LP.Character
	if not char then return nil end
	local bp = LP:FindFirstChild("Backpack")
	if not bp then return nil end
	local tool = bp:FindFirstChild(name)
	if not tool then
		local held = char:FindFirstChild(name)
		if held then return held end
		warn("背包里没有 " .. name)
		return nil
	end

	hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end
	hum:EquipTool(tool)

	for _ = 1, 8 do
		local t = char:FindFirstChild(name)
		if t then return t end
		task.wait(0.04)
	end
	return char:FindFirstChild(name)
end

local function repairCycle(item)
	if not item or not RequestDamage then return end
	local hrp = getHRP()
	if not hrp then return end
	if (item.Centre.Position - hrp.Position).Magnitude > (opts.MaxDist == 0 and 999 or opts.MaxDist + 1) then return end

	local toolName = resolveTool(item.Name, swingIndex)
	local tool = forceEquip(toolName)
	if not tool then return end

	local centre = item.Centre

	if opts.Animate and ReplicateAnimation then
		ReplicateAnimation:FireServer("Tool", toolName, "IdleToSwing")
		task.wait(0.1)
		ReplicateAnimation:FireServer("Effect", toolName, "Construct")
	end

	RequestDamage:FireServer(centre, centre.Position, tool, "ConstructMelee", -1)

	if opts.Animate and ReplicateAnimation then
		task.wait(0.08)
		ReplicateAnimation:FireServer("Tool", toolName, "SwingToIdle")
	end

	swingIndex = swingIndex + 1
end

local function startLoop()
	if running then return end
	running = true
	task.spawn(function()
		while running do
			local t0 = os.clock()
			local ok, err = pcall(function()
				local item = nearest(opts.Mode, opts.MaxDist)
				repairCycle(item)
			end)
			if not ok then
				warn("循环异常：" .. tostring(err))
				forceEquip(opts.Tool)
				task.wait(0.5)
			end
			local rest = opts.Interval - (os.clock() - t0)
			if rest > 0 then task.wait(rest) end
		end
	end)
end

local function stopLoop()
	running = false
end

local function resolveGroup(force)
	if not force and doorGroup and doorGroup.Parent then return doorGroup end
	doorGroup = nil
	doorRemoteCache = nil

	local map = workspace:FindFirstChild("Map", true)
	if map then
		local d = map:FindFirstChild("Destructable", true)
		if d then
			doorGroup = d
			return doorGroup
		end
	end

	local d2 = workspace:FindFirstChild("Destructable", true)
	if d2 then
		doorGroup = d2
		return doorGroup
	end
	return nil
end

local function collectRemotes(force)
	if not force and doorRemoteCache then return doorRemoteCache end
	local list = {}
	local group = resolveGroup(force)
	doorRemoteCache = list
	if not group then return list end
	for _, obj in ipairs(group:GetDescendants()) do
		if obj.Name == "Interact" and (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("BindableEvent")) then
			list[#list + 1] = {remote = obj, group = group}
		end
	end
	return list
end

local function remotePos(remote, group)
	local inst = remote
	while inst and inst ~= group do
		if inst:IsA("BasePart") then return inst.Position end
		inst = inst.Parent
	end
	return nil
end

local function fireOne(remote)
	if remote:IsA("RemoteEvent") then
		remote:FireServer()
	elseif remote:IsA("RemoteFunction") then
		pcall(function() remote:InvokeServer() end)
	elseif remote:IsA("BindableEvent") then
		remote:Fire()
	end
end

local function fireDoors()
	local char = LP.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local now = os.clock()
	local list = collectRemotes(false)
	if #list == 0 then
		list = collectRemotes(true)
	end
	for _, entry in ipairs(list) do
		local remote = entry.remote
		local pos = remotePos(remote, entry.group)
		local near = true
		if pos and hrp then
			near = (pos - hrp.Position).Magnitude <= opts.DoorDist
		end
		if near and (now - (doorLast[remote] or 0) >= opts.DoorCd) then
			doorLast[remote] = now
			pcall(function() fireOne(remote) end)
		end
	end
end

local function doorStart()
	if doorRunning then return end
	doorRunning = true
	task.spawn(function()
		while doorRunning do
			local ok, err = pcall(fireDoors)
			if not ok then warn("开门异常：" .. tostring(err)) end
			task.wait(opts.DoorScan)
		end
	end)
end

