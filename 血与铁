local function voteArg()
	if not opts.VoteTarget then return nil end
	local pl = Players:FindFirstChild(opts.VoteTarget)
	if opts.VoteMode == "UserId" then
		if pl then return pl.UserId end
		return tonumber(opts.VoteTarget) or opts.VoteTarget
	end
	if pl then return pl.Name end
	return opts.VoteTarget
end

local function voteOnce()
	if not VoteEvent then
		voteLast.res = "找不到 RequestVoteKick"
		voteLast.ok = false
		return false, voteLast.res
	end
	local arg = voteArg()
	if not arg then
		voteLast.res = "未选择投票目标"
		voteLast.ok = false
		return false, voteLast.res
	end
	local ok, res = pcall(function()
		return VoteEvent:InvokeServer(arg)
	end)
	voteLast.count = voteLast.count + 1
	if ok then
		voteLast.ok = true
		voteLast.res = tostring(res)
		return true, res
	end
	voteLast.ok = false
	voteLast.res = tostring(res)
	return false, res
end

local function voteBurstOnce()
	for _ = 1, math.max(1, math.floor(opts.VoteBurst)) do
		voteOnce()
		task.wait(0.01)
	end
end

local function voteStart()
	if voteRunning then return end
	if not opts.VoteTarget then
		WindUI:Notify({Title = "提示", Content = "还没选投票目标", Duration = 2.5})
		return
	end
	voteRunning = true
	voteOnce()
	for _ = 1, math.max(1, math.floor(opts.VoteThreads)) do
		task.spawn(function()
			while voteRunning do
				local ok, err = pcall(voteBurstOnce)
				if not ok then warn("投票异常：" .. tostring(err)) end
				task.wait(opts.VoteDelay)
			end
		end)
	end
end

