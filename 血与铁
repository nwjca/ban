local function poseHook()
	local char = LP.Character
	local neck = char and char:FindFirstChild("Neck", true)
	if neck == poseCache.neck and neckConn then return end
	if neckConn then
		pcall(function() neckConn:Disconnect() end)
		neckConn = nil
	end
	poseCache.char = char
	poseCache.neck = neck
	if not neck then return end
	poseCache.n0 = neck.C0
	poseCache.base = CFrame.new(0, 1, 0) * R6_NECK_BASE
	neckConn = neck:GetPropertyChangedSignal("C0"):Connect(function()
		if opts.PoseOn and not applying then
			poseApply()
		end
	end)
end

local function poseApply()
	if not opts.PoseOn or applying then return end
	poseHook()
	local neck = poseCache.neck
	if not neck or not poseCache.base then return end
	applying = true
	neck.C0 = CFrame.Angles(math.rad(opts.Pitch), 0, 0) * poseCache.base
	applying = false
end

local function poseRestore()
	if poseCache.neck and poseCache.n0 then
		applying = true
		poseCache.neck.C0 = poseCache.n0
		applying = false
	end
end

RunService.Stepped:Connect(function()
	if opts.PoseOn then
		pcall(poseApply)
	end
end)

local function poseBind()
	pcall(function() RunService:UnbindFromRenderStep(POSE_RENDER) end)
	RunService:BindToRenderStep(POSE_RENDER, 301, poseApply)
end

local function poseUnbind()
	pcall(function() RunService:UnbindFromRenderStep(POSE_RENDER) end)
end

local function setPose(state)
	opts.PoseOn = state
	if state then
		poseHook()
		poseApply()
		poseBind()
	else
		poseUnbind()
		poseRestore()
	end
end

local function tpLoop()
	local cam = workspace.CurrentCamera
	local char = LP.Character
	local head = char and char:FindFirstChild("Head")
	if not cam or not head then return end
	local dist = (cam.CFrame.Position - head.Position).Magnitude
	if dist >= opts.TPDist then return end
	local look = cam.CFrame.LookVector
	local pos = head.Position - look * opts.TPDist + Vector3.new(0, 1, 0)
	cam.CFrame = CFrame.lookAt(pos, pos + look)
end

local function tpBind()
	pcall(function() RunService:UnbindFromRenderStep(TP_RENDER) end)
	RunService:BindToRenderStep(TP_RENDER, Enum.RenderPriority.Camera.Value + 1, tpLoop)
end

local function tpUnbind()
	pcall(function() RunService:UnbindFromRenderStep(TP_RENDER) end)
end

local function setTP(state)
	opts.TPForce = state
	if state then
		if not origZoom then
			origZoom = {min = LP.CameraMinZoomDistance, max = LP.CameraMaxZoomDistance}
		end
		LP.CameraMinZoomDistance = math.max(0.5, math.min(opts.TPDist, LP.CameraMaxZoomDistance))
		tpBind()
		tpLoop()
	else
		tpUnbind()
		if origZoom then
			LP.CameraMinZoomDistance = origZoom.min
			LP.CameraMaxZoomDistance = origZoom.max
		end
	end
end

local function validTarget(pl)
	if pl == LP then return nil end
	local char = pl.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	local head = char:FindFirstChild("Head")
	if not head then return nil end
	if opts.AimTeam and LP.Team and pl.Team then
		if pl.Team == LP.Team then return nil end
	end
	return head
end

local function hasLOS(cam, char, head)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {LP.Character, cam}
	local res = workspace:Raycast(cam.CFrame.Position, head.Position - cam.CFrame.Position, rp)
	if not res then return true end
	return res.Instance:IsDescendantOf(char)
end

local function pickAimTarget()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local vp = cam.ViewportSize
	local center = Vector2.new(vp.X / 2, vp.Y / 2)
	local best, bestD = nil, math.huge
	for _, pl in ipairs(Players:GetPlayers()) do
		local head = validTarget(pl)
		if head then
			local sp, onScreen = cam:WorldToViewportPoint(head.Position)
			if onScreen and sp.Z > 0 then
				local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
				if d <= opts.AimFov and d < bestD then
					if opts.AimWall then
						if hasLOS(cam, pl.Character, head) then
							best, bestD = {char = pl.Character, head = head}, d
						end
					else
						best, bestD = {char = pl.Character, head = head}, d
					end
				end
			end
		end
	end
	return best
end

local hookOk = pcall(function()
	local oldIndex
	oldIndex = hookmetamethod(game, "__index", function(t, k)
		if aimTarget and t == mouse then
			if k == "Hit" then
				return CFrame.new(aimTarget.head.Position)
			elseif k == "Target" then
				return aimTarget.head
			elseif k == "UnitRay" then
				local cam = workspace.CurrentCamera
				if cam then
					return Ray.new(cam.CFrame.Position, (aimTarget.head.Position - cam.CFrame.Position).Unit)
				end
			end
		end
		return oldIndex(t, k)
	end)
end)

if not hookOk then
	warn("沉默瞄准 Hook 失败，当前执行器可能不支持 hookmetamethod")
end

