local function isValidTarget(model)
    if not model then return false end
    if model == LocalPlayer.Character then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
    if isPlayer then
        return targetMode == "仅玩家" or targetMode == "玩家和NPC"
    else
        return targetMode == "仅NPC" or targetMode == "玩家和NPC"
    end
end

local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getNearestTarget(root)
    if not root then return nil end
    local bestRoot, bestHum, bestModel, minDist = nil, nil, nil, scanRange
    local parts = Workspace:GetPartBoundsInRadius(root.Position, scanRange)
    for _, part in ipairs(parts) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model and isValidTarget(model) then
            local targetRoot = model:FindFirstChild("HumanoidRootPart")
            local hum = model:FindFirstChildOfClass("Humanoid")
            if targetRoot and hum then
                local dist = (root.Position - targetRoot.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    bestRoot = targetRoot
                    bestHum = hum
                    bestModel = model
                end
            end
        end
    end
    return bestRoot, bestHum, bestModel
end

local function killAnimations()
    local char = LocalPlayer.Character
    if not char then return end

    local animate = char:FindFirstChild("Animate")
    if animate and animate:IsA("BaseScript") then
        animate.Disabled = true
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
        track:Stop(0)
    end

    if not animConn then
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            animConn = animator.AnimationPlayed:Connect(function(track)
                if removeAnim then
                    track:Stop(0)
                end
            end)
        end
    end
end

local function restoreAnimations()
    if animConn then
        animConn:Disconnect()
        animConn = nil
    end
    local char = LocalPlayer.Character
    local animate = char and char:FindFirstChild("Animate")
    if animate and animate:IsA("BaseScript") then
        animate.Disabled = false
    end
end

local function faceTarget()
    local root = getRoot()
    if not root then return false end

    local targetRoot, _, targetModel = getNearestTarget(root)
    if not targetRoot then return false end

    root.CFrame = CFrame.lookAt(root.Position, Vector3.new(
        targetRoot.Position.X,
        root.Position.Y,
        targetRoot.Position.Z
    ))

    if targetModel then
        lastTargetName = targetModel.Name
    end
    return true
end

local function tryFace()
    local player = faceClosestPlayer()
    if player then
        lastTargetName = player.Name
        return true
    end
    return faceTarget()
end

local function isLocked()
    return (os.clock() - lastLockTime) <= LOCK_VALID_TIME
end

local function waitForFace()
    while enabled do
        if isLocked() then return true end
        if tryFace() then
            lastLockTime = os.clock()
            return true
        end
        task.wait(0.01)
    end
    return false
end

local function getJumpingPlayer(root)
    local bestModel, minDist = nil, scanRange
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            if char and char ~= LocalPlayer.Character then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local targetRoot = char:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and targetRoot then
                    local dist = (root.Position - targetRoot.Position).Magnitude
                    if dist <= minDist then
                        local state = hum:GetState()
                        local vy = targetRoot.AssemblyLinearVelocity.Y
                        local airborne =
                            state == Enum.HumanoidStateType.Jumping
                            or state == Enum.HumanoidStateType.Freefall
                            or state == Enum.HumanoidStateType.FallingDown
                            or math.abs(vy) > 2
                        if airborne then
                            minDist = dist
                            bestModel = char
                        end
                    end
                end
            end
        end
    end
    return bestModel
end

local function teleportToFront(model)
    local root = getRoot()
    local targetRoot = model and model:FindFirstChild("HumanoidRootPart")
    if not (root and targetRoot) then return false end

    local newPos = (targetRoot.CFrame * CFrame.new(0, 0, -jumpTpDist)).Position
    root.CFrame = CFrame.lookAt(newPos, Vector3.new(
        targetRoot.Position.X,
        newPos.Y,
        targetRoot.Position.Z
    ))
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    lastTargetName = model.Name
    jumpTpLastHitting = model.Name
    lastLockTime = os.clock()
    return true
end

local function stopJumpTp()
    jumpTpEnabled = false
    if jumpTpThread then
        task.cancel(jumpTpThread)
        jumpTpThread = nil
    end
end

local function startJumpTp()
    stopJumpTp()
    jumpTpEnabled = true
    jumpTpLastTime = 0

    jumpTpThread = task.spawn(function()
        while jumpTpEnabled do
            local root = getRoot()
            if root then
                local now = os.clock()
                if now - jumpTpLastTime >= jumpTpCooldown then
                    local model = getJumpingPlayer(root)
                    if model then
                        if teleportToFront(model) then
                            jumpTpLastTime = now
                            jumpTpCount = jumpTpCount + 1
                        end
                    end
                end
            end
            RunService.RenderStepped:Wait()
        end
        jumpTpThread = nil
    end)
end

local function playEmote(name)
    if not PlayEmoteEvent then return false end
    local ok = pcall(function()
        PlayEmoteEvent:FireServer(name)
    end)
    if ok then
        emoteCount = emoteCount + 1
    end
    return ok
end

local function cancelByEmote()
    if not emoteCancel then return end
    playEmote(emoteName)
end

local function fireBurst()
    local root = getRoot()
    if not root then return false end
    if not AttackEvent then return false end
    if not waitForFace() then return false end

    for i, variant in ipairs(attackVariants) do
        if not enabled then return false end

        local targetRoot = getNearestTarget(root)
        local pos
        if posMode == "目标坐标" then
            pos = targetRoot and targetRoot.Position or root.Position
        elseif posMode == "自身坐标" then
            pos = root.Position
        else
            pos = fixedPositions[i] or root.Position
        end

        pcall(function()
            AttackEvent:FireServer(pos, variant.a, variant.b)
        end)

        variantCount[i] = (variantCount[i] or 0) + 1
        lastSentIndex = i
        totalSent = totalSent + 1

        cancelByEmote()

        if shotInterval > 0 then
            task.wait(shotInterval)
        end
    end
    return true
end

local function updateStats()
    if statsLabel then
        local lines = {}
        for i, v in ipairs(attackVariants) do
            local mark = (i == lastSentIndex) and " <<<" or ""
            table.insert(lines, string.format("%d) a=%s b=%s  ×%d%s", i, tostring(v.a), tostring(v.b), variantCount[i] or 0, mark))
        end
        table.insert(lines, string.format("总计发送 %d 次", totalSent))
        pcall(function()
            statsLabel:SetTitle(table.concat(lines, "\n"))
        end)
    end
    refreshInfo()
end

stopAttack = function()
    enabled = false
    if faceThread then
        task.cancel(faceThread)
        faceThread = nil
    end
    if attackThread then
        task.cancel(attackThread)
        attackThread = nil
    end
    if statsThread then
        task.cancel(statsThread)
        statsThread = nil
    end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and savedAutoRotate ~= nil then
        hum.AutoRotate = savedAutoRotate
        savedAutoRotate = nil
    end
    lastLockTime = 0
    updateStats()
end

startAttack = function()
    if not AttackEvent then
        WindUI:Notify({ Title = "错误", Content = "未找到 Remotes.Attack", Icon = "x", Duration = 2 })
        return false
    end
    stopAttack()
    enabled = true

    for i = 1, #attackVariants do
        variantCount[i] = 0
    end
    totalSent = 0
    lastSentIndex = 0

    if lockFacing then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            savedAutoRotate = hum.AutoRotate
            hum.AutoRotate = false
        end
        if removeAnim then
            killAnimations()
        end
    end

    faceThread = task.spawn(function()
        while enabled do
            if tryFace() then
                lastLockTime = os.clock()
            end
            RunService.RenderStepped:Wait()
        end
        faceThread = nil
    end)

    attackThread = task.spawn(function()
        while enabled do
            local ok = fireBurst()
            if ok then
                task.wait(roundDelay)
            else
                task.wait(0.1)
            end
        end
        attackThread = nil
    end)

    statsThread = task.spawn(function()
        while enabled do
            updateStats()
            task.wait(0.5)
        end
        statsThread = nil
    end)

    return true
end

local function rollOnce()
    if not RollEvent then return false end
    local ok = pcall(function()
        RollEvent:InvokeServer()
    end)
    rollCount = rollCount + 1
    if ok then
        rollSuccess = rollSuccess + 1
    end
    return ok
end

local function stopRoll()
    rollEnabled = false
    for i = #rollThreads, 1, -1 do
        task.cancel(rollThreads[i])
        rollThreads[i] = nil
    end
end

local function startRoll()
    if not RollEvent then
        WindUI:Notify({ Title = "错误", Content = "未找到 Remotes.RollAttack", Icon = "x", Duration = 2 })
        return false
    end
    stopRoll()
    rollEnabled = true
    rollCount = 0
    rollSuccess = 0

    for _ = 1, math.max(1, rollWorkers) do
        local thread = task.spawn(function()
            while rollEnabled do
                rollOnce()
                task.wait(rollDelay)
            end
        end)
        table.insert(rollThreads, thread)
    end
    return true
end

local function probeRoll(duration)
    if not RollEvent then return end
    duration = duration or 2

    local start = os.clock()
    local calls, oks = 0, 0
    local minLat, maxLat, sumLat = math.huge, 0, 0
    local lastRes

    while os.clock() - start < duration do
        local t0 = os.clock()
        local ok, res = pcall(function()
            return RollEvent:InvokeServer()
        end)
        local lat = os.clock() - t0

        calls = calls + 1
        if ok then oks = oks + 1 end
        sumLat = sumLat + lat
        minLat = math.min(minLat, lat)
        maxLat = math.max(maxLat, lat)
        lastRes = res
    end

    local elapsed = os.clock() - start
    local rate = calls / elapsed

    print(string.format(
        "调用 %d 次 / 成功 %d 次 / 用时 %.2f 秒 / 速率 %.2f 次/秒 / 延迟 min %.3f max %.3f avg %.3f",
        calls, oks, elapsed, rate, minLat, maxLat, sumLat / calls
    ))
    print("最后一次返回:", tostring(lastRes))

    WindUI:Notify({
        Title = "冷却探测",
        Content = string.format("速率 %.2f 次/秒，成功 %d/%d", rate, oks, calls),
        Duration = 3
    })
end

local function stopEmotes()
    emoteEnabled = false
    if emoteThread then
        task.cancel(emoteThread)
        emoteThread = nil
    end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end
end

local function startEmotes()
    if not PlayEmoteEvent then
        WindUI:Notify({ Title = "错误", Content = "未找到 Remotes.PlayEmote", Icon = "x", Duration = 2 })
        return false
    end
    stopEmotes()
    emoteEnabled = true
    emoteThread = task.spawn(function()
        while emoteEnabled do
            playEmote(emoteName)
            task.wait(emoteDelay)
        end
        emoteThread = nil
    end)
    return true
end

