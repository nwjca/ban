local function rebuildVariants()
    attackVariants = {}
    for i, v in ipairs(baseVariants) do
        local a, b = v.a, v.b
        if i <= 5 then
            if damageSlot == "第二参数" then
                a = damageValue
            elseif damageSlot == "第三参数" then
                b = damageValue
            else
                a = damageValue
                b = damageValue
            end
        end
        attackVariants[i] = { a = a, b = b }
    end
    variantCount = {}
    for i = 1, #attackVariants do
        variantCount[i] = 0
    end
end

